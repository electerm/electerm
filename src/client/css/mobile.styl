// ---------------------------------------------------------------------------
// Mobile UI driven by store.isMobile (is-mobile class on root)
// Breakpoint: 600px (see mobileBreakpoint in constants.js)
// ---------------------------------------------------------------------------
.is-mobile
  // ---- 1. Tabs: show only current tab + dropdown, close icon always visible
  .tabs.mobile-tabs
    display flex
    align-items center
    overflow hidden
  // leave room for window controls on desktop platforms resized narrow
  &.not-system-ui.not-mac.not-webapp
    .tabs.mobile-tabs
      padding-right 94px
  .mobile-tabs-inner
    flex 1
    min-width 0
    overflow hidden
    display flex
    align-items center
    margin-left 0 !important
    width auto !important
    .tab
      flex 1
      max-width none
      min-width 0
      width auto
      text-align left
      // close icon always visible on mobile
      .tab-close
        display block
  // keep a left drag grip for the custom title bar (not webapp, not system-ui),
  // so the empty area left of the tab is draggable. mac needs extra room for
  // the traffic-light window controls in the top-left.
  &.not-system-ui.not-webapp
    .mobile-tabs-inner
      margin-left 20px !important
    &.is-mac
      .mobile-tabs-inner
        margin-left 72px !important
  // AppDrag wraps .mobile-tabs-inner under a custom title bar; make it the flex
  // item so the tab layout is unchanged and the inner's left drag grip stays
  // inside the draggable .app-drag box.
  .tabs.mobile-tabs > .app-drag
    flex 1
    min-width 0
    display flex
    align-items center
    overflow hidden
  .mobile-tabs-extra
    flex-shrink 0
    display flex
    align-items center
    padding 0 10px
    line-height 36px
    z-index 20
    .tabs-add-btn
      margin 0
      &.empty
        font-size 20px
        margin 0
    .tabs-dd-icon
      margin-left 8px
      font-size 14px
      color var(--text)
      &:hover
        color var(--text-light)
  // tabs-extra must not render on mobile (defensive css too)
  .tabs-extra
    display none !important

  // ---- 2. Footer batch input: show "B" button, click to expand
  // match the quick-commands "Q" button: no flex-grow, same small margin
  .terminal-footer-center
    flex-grow 0
    margin-left 3px
  .batch-input-outer
    &.bi-show
      .bi-full
        // full-width fixed popup above the footer (mobile is narrow)
        position fixed
        left 0
        right 0
        bottom 36px
        z-index 200
        background var(--main)
        padding 8px 10px
        box-shadow 0 -2px 8px rgba(0, 0, 0, 0.2)
        width auto
        min-width 0
        border-radius 0

  // ---- 3. Footer encode select: show icon, click to open dropdown
  //        match antd Button small icon size (~14px) used by sibling icons
  .mobile-encode-trigger,
  .terminal-info-icon,
  .show-sidebar-icon
    font-size 14px !important
    line-height 36px
    padding 0 4px
    &:hover
      color var(--text-light)

  // ---- 4. Modal: full width / full bleed on mobile
  .custom-modal-container
    padding 0
  .custom-modal-content
    width 100% !important
    max-width 100vw
    margin-top 0
    min-height 100vh
    border-radius 0

  // ---- 5. Sync panel data transport: stack export/import and auto-sync
  //        vertically with a gap. On narrow screens the right-floated
  //        auto-sync block wraps under the import button with no vertical
  //        gap — left-align it and add breathing room.
  .sync-data-transport
    .fleft,
    .fright
      float none
    .fright
      margin-top 8px
      // the switch carries mg3l (32px left margin) to separate it from the
      // import button on desktop — reset it when stacked so it left-aligns
      .ant-switch
        margin-left 0

  // ---- 6. Solid Radio.Button groups (e.g. SSH auth type selector, session
  //        type selector): on narrow screens the connected button row wraps,
  //        but antd styles it as a single horizontal strip — adjacent buttons
  //        share borders via -1px margin and border-radius is only applied to
  //        the first/last child. When the row wraps, radius/borders break and
  //        the UI looks messed up. Convert each button to a standalone pill so
  //        wrapping stays tidy.
  .ant-radio-group.ant-radio-group-solid
    display flex
    flex-wrap wrap
    gap 6px
    .ant-radio-button-wrapper
      border-radius 3px
      margin-inline-end 0
      &::before
        display none

  // ---- 7. Terminal info panel button group: on narrow screens the connected
  //        button row in terminal info panel wraps, but antd styles it as a
  //        single horizontal strip. When the row wraps, the UI looks broken.
  //        Convert each button to a standalone pill so wrapping stays tidy.
  .terminal-info-base
    .ant-space-compact
      display flex
      flex-wrap wrap
      gap 6px
      .ant-btn
        border-radius 3px
        margin-right 0

  // ---- 8. Upgrade panel: fixed 440px width overflows narrow mobile screens.
  //        Constrain it to the viewport minus the right offset (10px) and a
  //        matching left gap so it never extends past the screen edge.
  .upgrade-panel
    max-width calc(100vw - 20px)

  // ---- 9. Terminal touch support: prevent the browser's native long-press
  //        callout (iOS "Copy/Look Up" menu) and text-selection gesture from
  //        interfering with xterm's own touch handling and our custom
  //        long-press context-menu detection. xterm.js already sets
  //        user-select:none on .xterm; we additionally suppress the iOS
  //        callout and set touch-action so the browser does not compete with
  //        xterm for touch gesture interpretation.
  .term-wrap
    -webkit-touch-callout none
    -webkit-tap-highlight-color transparent
    .xterm
      -webkit-touch-callout none
      touch-action none

// ---------------------------------------------------------------------------
// Touch-primary devices only (feature-detected via pointer media query, not
// UA sniffing or viewport width). Desktop browsers (even with touchscreens or
// narrow windows) report pointer: fine, so this never matches them.
//
// 1. iOS Safari and Android Chrome auto-zoom the page when focusing an input
//    with font-size < 16px, and never zoom back out on blur, leaving the page
//    stuck zoomed. Force 16px on all focusable form fields (antd inputs default
//    to 14px) to prevent the zoom.
//
// 2. Mobile browsers also inflate text to improve readability
//    (-webkit-text-size-adjust defaults to auto). Inside a fixed-size container
//    this makes the text taller than its wrapper, so it gets clipped — the
//    clearest victim is the antd small Switch, whose track is only 16px tall /
//    28px wide with overflow:hidden; the "sort by frequency" label gets blown
//    past the track and chopped. Pin to 100% so the declared font-size is
//    honored.
// ---------------------------------------------------------------------------
@media (pointer: coarse)
  input,
  textarea,
  select,
  .ant-input,
  .ant-input-affix-wrapper .ant-input,
  .ant-input-number-input,
  .ant-select-selection-search-input
    font-size 16px !important
  html
    -webkit-text-size-adjust 100%
    text-size-adjust 100%
