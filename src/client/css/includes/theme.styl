:root
  --main #141314
  --main-dark #000
  --main-light #2E3338
  // the terminal area's own background: the active theme's terminal:background,
  // set by components/main/ui-theme.jsx. Defaults to the UI main colour so a
  // theme that does not define one keeps the old look.
  --main-terminal var(--main)
  --text #ddd
  --text-light #fff
  --text-dark #888
  --text-disabled #777
  --primary #08c
  --info #FFD166
  --success #06D6A0
  --error #EF476F
  --warn #E55934
  --primary-contrast #fff
  --main-darker #0e0d0e
  --main-lighter #5b5a5b
