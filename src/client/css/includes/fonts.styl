// Curated monospace fonts offered in the per-bookmark terminal font
// picker. Regular weight only (400) - xterm.js synthesizes bold via
// canvas faux-bold when no bold face is loaded, so a second weight
// isn't needed. Latin subset only.
@font-face
  font-family 'Fira Code'
  font-style normal
  font-weight 400
  font-display swap
