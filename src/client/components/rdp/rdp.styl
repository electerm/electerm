// RDP only styling — the session layout (control bar, viewport, fit mode)
// lives in the shared remote session shell: common/remote-session-shell.styl

// fit: the canvas box fills the viewport and the remote surface is letterboxed
// inside it with object-fit: contain, so the aspect ratio is kept and the
// letterbox keeps the app background
.rdp-session-wrap
  &.fit
    .rdp-canvas
      object-fit contain

// fit off: rendered at the remote desktop size, the viewport scrolls
.rdp-canvas
  display block
  outline none

.rdp-file-transfer-btn
  font-size: 16px
  color: var(--text)
  transition: color 0.2s
  &:hover
    color: var(--primary)

.rdp-download-disabled
  opacity: 0.4
  cursor: not-allowed
  &:hover
    color: var(--text)

@keyframes rdp-download-flash
  0%, 100%
    color: var(--primary)
    transform: scale(1)
  50%
    color: var(--success)
    transform: scale(1.2)

.rdp-download-flash
  animation: rdp-download-flash 1s ease-in-out infinite
