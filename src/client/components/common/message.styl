.message-container
  position fixed
  top 20px
  left 50%
  transform translateX(-50%)
  z-index 10000
  pointer-events none

.message-item
  pointer-events all
  margin-bottom 16px
  padding 8px 16px
  border-radius var(--radius-sm)
  background var(--main-lighter)
  color var(--text)
  box-shadow var(--shadow-2)
  display flex
  align-items center
  animation message-fade-in 0.3s ease
  position relative
  justify-content center
  &:hover
    .message-close
      opacity 1

// v4 状态色底芯片：14% 色底 + 左 3px 状态条（美化设计规范 §2.8）
.message-item:has(.msg-icon.success)
  background var(--success-bg)
  box-shadow inset 3px 0 0 0 var(--success), var(--shadow-2)
.message-item:has(.msg-icon.error)
  background var(--error-bg)
  box-shadow inset 3px 0 0 0 var(--error), var(--shadow-2)
.message-item:has(.msg-icon.warning)
  background var(--warn-bg)
  box-shadow inset 3px 0 0 0 var(--warn), var(--shadow-2)
.message-item:has(.msg-icon.info)
  background var(--info-bg)
  box-shadow inset 3px 0 0 0 var(--info), var(--shadow-2)

.message-content-wrap
  display flex
  align-items center

.msg-icon
  margin-right 8px
  font-size 16px
  &.info
    color var(--info)
  &.success
    color var(--success)
  &.warning
    color var(--warn)
  &.error
    color var(--error)

.message-close
  margin-left 8px
  cursor pointer
  font-size 12px
  color var(--text)
  &:hover
    font-weight bold

@keyframes message-fade-in
  from
    opacity 0
    transform translateY(-20px)
  to
    opacity 1
    transform translateY(0)
