.mcp-transfer-confirm
  font-size 13px
  line-height 1.6

  .mcp-transfer-row
    margin-bottom 8px

  .mcp-transfer-label
    opacity 0.65
    margin-right 6px

  .mcp-transfer-path
    font-family var(--mono-font, Menlo, Consolas, monospace)
    word-break break-all

  .mcp-transfer-warn
    margin-top 10px
    padding 8px 10px
    border-radius 4px
    border 1px solid var(--danger, #d4380d)
    color var(--danger, #d4380d)
