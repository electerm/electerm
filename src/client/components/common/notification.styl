.notification-container
  position fixed
  bottom 20px
  right 20px
  z-index 9999

.notification
  background var(--surface-2)
  color var(--text)
  border-radius var(--radius-sm)
  margin-bottom 10px
  padding 12px 16px
  box-shadow var(--shadow-2)
  width 400px
  position relative

// v4 状态色底芯片（根节点带 type 类，见 notification.jsx:137）
.notification.success
  background var(--success-bg)
  box-shadow inset 3px 0 0 0 var(--success), var(--shadow-2)
.notification.error
  background var(--error-bg)
  box-shadow inset 3px 0 0 0 var(--error), var(--shadow-2)
.notification.warning
  background var(--warn-bg)
  box-shadow inset 3px 0 0 0 var(--warn), var(--shadow-2)
.notification.info
  background var(--info-bg)
  box-shadow inset 3px 0 0 0 var(--info), var(--shadow-2)

.notification-content
  width 100%

.notification-message
  font-weight bold

.notification-title
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
  padding 0 30px 0 20px

.notification-icon
  font-size 16px
  position absolute
  left 12px
  top 10px

.notification-description
  word-wrap break-word
  max-height 200px
  overflow auto
  padding 10px 0 0 0

.notification-close
  position absolute
  top 12px
  right 12px
  background none
  border none
  color var(--text-dark)
  font-size 18px
  cursor pointer
  padding 0
  &:hover
    color var(--text)

.notification-copy-icon
  cursor pointer
  font-size 14px
  position absolute
  right 10px
  top 45px
  margin-left 8px
  display none
.notification-message .notification-copy-icon
  right 38px
  top 14px
.notification-message:hover .notification-copy-icon,
.notification-description:hover .notification-copy-icon
  display inline-block