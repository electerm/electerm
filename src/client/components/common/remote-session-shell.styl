// shared remote session (rdp/vnc/spice) shell, see remote-session-shell.jsx

.remote-session-wrap
  display flex
  flex-direction column
  width 100%
  height 100%
  min-height 0
  background var(--main)

// antd Spin root carries the className, both levels must pass the height on
// or the session inside has nothing to resolve `height: 100%` against
.remote-session-spin
  height 100%
  > .ant-spin-container
    height 100%

// control bar: one row while there is room, wraps to more rows when the
// window is narrow, so no action icon ever gets pushed out of reach
.remote-session-control
  position relative
  flex 0 0 auto
  display flex
  flex-wrap wrap
  align-items center
  justify-content space-between
  row-gap 4px
  padding 4px 8px
  z-index 300

.remote-session-control-left
.remote-session-control-right
  display flex
  flex-wrap wrap
  align-items center
  row-gap 4px
  min-width 0

.remote-session-control-right
  margin-left auto

.remote-session-viewport
  position relative
  flex 1 1 auto
  display flex
  min-width 0
  min-height 0
  overflow auto
  // scrolled when fit is off, i.e. the remote surface at its own size
  &::-webkit-scrollbar
    width 16px
    height 16px
    background var(--main-darker)
  &::-webkit-scrollbar-track
    background var(--main-darker)
    box-shadow inset 0 0 5px var(--main-darker)
  &::-webkit-scrollbar-thumb
    background var(--primary)
    border-radius 0
  &::-webkit-scrollbar-corner
    background var(--main-darker)
  > *
    flex 0 0 auto
    margin auto

// fit: scale the remote surface to the viewport, keeping the source aspect
// ratio, so at most one axis keeps empty margin and fullscreen has as little
// empty space as the ratio allows
.remote-session-wrap.fit
  .remote-session-viewport
    overflow hidden
    > *
      width 100%
      height 100%
      margin 0

// surface that should always fill the viewport (noVNC sizes its canvas itself)
.remote-session-fill
  width 100%
  height 100%
