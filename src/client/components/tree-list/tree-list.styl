
.new-bookmark-btn.ant-btn
  border-radius 999px
  font-weight 600
  flex-shrink 0

.tree-control-btn
  display inline-flex
  align-items center
  justify-content center
  margin-left 3px
  width 16px
  line-height 30px
  height 26px
  border-radius 4px
  color var(--text-dark)
  transition background-color .12s ease, color .12s ease
  &:hover
    background var(--hover-bg)
    color var(--primary)
.tree-item
  display flex
  align-items center
  height 100%
  position relative
  padding-left 5px
  border-radius 4px
  overflow hidden
  transition background-color .12s ease, color .12s ease
  &.is-category
    .tree-item-title-main
      font-weight bold
      font-size 14px

  &.search-selected
    outline 1px dashed var(--primary)
  &.item-dragover
    outline 2px dashed var(--primary)
  &:hover
    background var(--hover-bg)
    cursor pointer
  &.selected
    background var(--primary)
    color var(--primary-contrast)
    .tree-item-subtitle
      color inherit
      opacity .75
  &.item-dragover-top
    border 2px solid var(--primary)
.tree-item-title
  display flex
  align-items center
  gap 6px
  flex-grow 1
  min-width 0
  overflow hidden
  white-space nowrap
  text-overflow ellipsis

.tree-item-text
  display flex
  flex-direction column
  min-width 0
  overflow hidden
  line-height 1.4
  .has-subtitle &
    line-height 1.3

.tree-item-title-main
  overflow hidden
  white-space nowrap
  text-overflow ellipsis

.tree-item-subtitle
  overflow hidden
  white-space nowrap
  text-overflow ellipsis
  font-size 11px
  color var(--text-dark)
  font-family 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace

.tree-item-count
  font-family 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace
  flex-shrink 0
  margin-left auto
  padding 0 7px
  min-width 18px
  height 18px
  line-height 18px
  text-align center
  font-size 11px
  font-weight 600
  border-radius 999px
  background var(--hover-bg)
  color var(--text-dark)
  .selected &
    background rgba(255, 255, 255, .25)
    color inherit

.sidebar-panel .tree-item-title
   max-width 100%
.with-plus
  &:after
    content '+'
    position absolute
    font-size 16px
    top 2px
    right 2px
.add-menu-wrap
  .tree-item-title
    padding-right 20px
  .is-category
    .tree-item-title
      padding-right 40px
  .edit-icon.tree-control-btn
  .open-all-icon.tree-control-btn
    position absolute
    right 0
    top 0
  .open-all-icon.tree-control-btn
    right 20px
.group-container
  padding-left 12px
  position relative
  line-height 30px
.tree-expander
  position absolute
  left 0
  top 0
  bottom 0
  width 12px
  font-size 11px
  display flex
  align-items center

.category-color-tag
  display inline-block
  width 12px
  height 12px
  margin-right 6px
  border-radius 2px
  border 1px solid #1a1a1a
  vertical-align middle

.move-item-tree-wrap
  max-height 300px
  overflow-y auto
  padding 8px

.tree-list
  display flex
  flex-direction column
  height 100%
  overflow hidden

.tree-list-header
  flex-shrink 0
  padding-bottom 8px
  margin-bottom 6px
  border-bottom 1px solid var(--border-color)

.item-list-wrap
  flex 1
  overflow-y auto
  min-height 0
  position relative

.tree-sort-wrap
  position relative
.tree-sort-dropdown
  display none
  position absolute
  right 0
  top 100%
  margin-top 4px
  background var(--main-light)
  border 1px solid var(--border-color)
  border-radius var(--radius-sm)
  padding 4px
  z-index 100
  box-shadow 0 4px 16px rgba(0,0,0,.35)
&.open
  .tree-sort-dropdown
    display block

.tree-sort-trigger
  cursor pointer
  &:hover
    color var(--primary)
  &.active
    color var(--primary)

.tree-sort-popover-item
  padding 4px 8px
  border-radius var(--radius-sm)
  cursor pointer
  white-space nowrap
  font-size 12px
  &:hover
    background var(--hover-bg)
  &.active
    color var(--primary)

.tree-list-virtual-spacer
  position relative
  width 100%

.tree-list-virtual-row
  position absolute
  left 0
  right 0

.tree-list-row
  box-sizing border-box
  width 100%
  height 100%
  position relative
  &.is-hidden
    visibility hidden
  &:hover
    .tree-item-title
      padding-right 60px
    .tree-item-op-wrap
      opacity 1
      pointer-events auto
.add-menu-wrap
.sidebar-panel
  .tree-list-row
    &:hover
      .tree-item-title
        padding-right 20px

.tree-list-row-group
  position relative
  height 100%
  padding-left 12px

.tree-list-editor-overlay
  position absolute
  right 4px
  z-index 4

.tree-item-op-wrap
  position absolute
  top 0
  bottom 0
  right 4px
  display flex
  align-items center
  z-index 3
  opacity 0
  pointer-events none
  &.is-active
    opacity 1
    pointer-events auto
