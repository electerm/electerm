// Mobile session control: pane tabs always visible,
// other icons shown in a floating Popover overlay
.mobile-session-control
  background var(--main)
  line-height 32px
  padding 0 10px
  display flex
  align-items center
  // pane tabs take available space, menu icon sits at the end
  .term-sftp-tabs
    float none
    display flex
    align-items center
    flex 1
    min-width 0
.mobile-control-toggle
.mobile-context-menu-toggle
  font-size 16px
  line-height 32px
  color var(--text)
  flex-shrink 0
  &:hover
    color var(--text-light)

// touch-only terminal context menu icon, in the bar next to the toggle above
.mobile-context-menu-toggle
  margin-right 10px

// Popover content — icons laid out in a row, wrapping as needed
.mobile-control-icons
  display flex
  flex-wrap wrap
  align-items center
  gap 4px 8px
  max-width 280px
  line-height 30px
  .term-controls
    float none
    display flex
    align-items center
    margin-left 0
  .sess-icon
    margin-right 0

// serial-control.jsx: control lines and status leds of a serial tab
.serial-control
  display inline-flex
  align-items center
  .serial-line
    font-size 12px
    &.active
      color var(--success)
.serial-leds
  display inline-flex
  gap 6px
  margin-right 10px
.serial-led
  font-size 12px
  color var(--text-light)
  .serial-led-dot
    display inline-block
    width 7px
    height 7px
    border-radius 50%
    margin-right 3px
    background var(--main-lighter)
    vertical-align 1px
  &.on
    color var(--text)
    .serial-led-dot
      background var(--success)
.serial-popover
  max-width 360px
  .serial-frame-label
    width 190px
  .serial-frame-input
    width 80px
  .serial-hint
    font-size 12px
    color var(--text-light)
.serial-cursor
  font-family monospace
  font-size 12px
  margin 0 6px
  white-space nowrap
