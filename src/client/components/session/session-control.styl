// Mobile session control: pane tabs always visible,
.sftp-follow-label
  display inline-flex
  align-items center
  gap 5px
  margin-right 12px
  font-size 12px
  cursor pointer
  input
    accent-color var(--primary)

.terminal-control button.split-view-toggle, .mobile-control-icons button.split-view-toggle
  border 0
  background transparent
  color inherit
  font inherit
  padding 0 6px
  &.active
    color var(--primary)

// other icons shown in a floating Popover overlay
.mobile-session-control
  background var(--main)
  line-height 32px
  padding 0 10px
  display flex
  align-items center
  // pane tabs take available space, menu icon sits at the end
  .term-sftp-tabs
    float none
    display flex
    align-items center
    flex 1
    min-width 0
.mobile-control-toggle
.mobile-context-menu-toggle
  font-size 16px
  line-height 32px
  color var(--text)
  flex-shrink 0
  &:hover
    color var(--text-light)

// touch-only terminal context menu icon, in the bar next to the toggle above
.mobile-context-menu-toggle
  margin-right 10px

// Popover content — icons laid out in a row, wrapping as needed
.mobile-control-icons
  display flex
  flex-wrap wrap
  align-items center
  gap 4px 8px
  max-width 280px
  line-height 30px
  .term-controls
    float none
    display flex
    align-items center
    margin-left 0
  .sess-icon
    margin-right 0
