// Mobile session control: pane tabs always visible,
// other icons shown in a floating Popover overlay
.mobile-session-control
  background var(--main)
  line-height 32px
  padding 0 10px
  display flex
  align-items center
  // pane tabs take available space, menu icon sits at the end
  .term-sftp-tabs
    float none
    display flex
    align-items center
    flex 1
    min-width 0
.mobile-control-toggle
.mobile-context-menu-toggle
  font-size 16px
  line-height 32px
  color var(--text)
  flex-shrink 0
  &:hover
    color var(--text-light)

// touch-only terminal context menu icon, in the bar next to the toggle above
.mobile-context-menu-toggle
  margin-right 10px

// Popover content — icons laid out in a row, wrapping as needed
.mobile-control-icons
  display flex
  flex-wrap wrap
  align-items center
  gap 4px 8px
  max-width 280px
  line-height 30px
  .term-controls
    float none
    display flex
    align-items center
    margin-left 0
  .sess-icon
    margin-right 0

.ssh-tunnel-panel
  width 100%
  max-width 440px
  max-height 65vh
  overflow auto
  overflow-wrap anywhere
  .mg60b
    margin-bottom 8px
.ant-popover .ssh-tunnel-panel
  width 80vw
.ssh-tunnel-row
  display flex
  align-items center
  justify-content space-between
  gap 12px
  padding-bottom 10px
