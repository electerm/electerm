@keyframes rotate
  from
    background-position -3000px
  to
    background-position 0px
.type-tab-line
  position absolute
  bottom 0
  left 0
  width 100%
  height 1px
  background var(--text-dark)
  display none
.type-tab-txt
  position relative
  display inline-block

.type-tab
  display inline-block
  vertical-align middle
  line-height 30px
  padding 0 20px 0 0
  margin-right 0px
  font-size 14px
  cursor pointer
  &:hover
  &.active
    color var(--text-light)
  &.active
    .type-tab-line
      display inline-block

.is-transporting
  .type-tab.sftp
    .type-tab-line
      display inline-block
      background linear-gradient(to right, var(--success) 0%, var(--main) 25%, var(--error) 50%, var(--primary) 75%, var(--success) 100%)
      animation: rotate 60s infinite linear
.disable-ssh
  .type-tab.ssh
    display none
.spliter
  color var(--text)
  &:hover
    color var(--text-light)

.sessions
  position absolute
  background var(--main)
.session-wrap
  display none
  position absolute
  overflow hidden
  z-index 3
  padding-top var(--tabs-height)
  box-shadow 0px 0px 1px 1px var(--main-darker)
  &.session-batch-active
    display block

.term-sftp-box
  height 100%
  // Keep xterm's z-index inside its pane so it can't cover the resize handle.
  > .ant-splitter > .ant-splitter-panel
    isolation isolate
.web-session-wrap
  height 100%
  background var(--main)
  overflow hidden
  display flex
  flex-direction column
.session-sidebar
  display flex
  height 100%
.session-sidebar-body
  flex 1
  min-width 0
  overflow hidden
.session-bookmarks
  height 100%
.session-sidebar-rail
  display none
.has-session-sidebar .session-sidebar-rail
  display flex
  flex none
  flex-direction column
  background var(--main-dark)
  border-right 1px solid var(--text-disabled)
  box-sizing border-box
  button
    border 0
    background transparent
    height 28px
    padding 0
    cursor pointer
    color var(--text)
    &:hover, &[aria-expanded=true]
      background var(--main-light)
    .anticon-star
      color #d9ab40
.web-session-content
  flex 1
  min-height 0
  overflow hidden
.session-v-info
  line-height 30px

.not-split-view > .ant-splitter-bar .ant-splitter-bar-dragger
  display none

.sess-icon
  margin-right 10px
  &.active
    color var(--warn)

.wrap-toggle-icon
.split-view-toggle
  &.active
    color var(--success)
