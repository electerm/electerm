@keyframes rotate
  from
    background-position -3000px
  to
    background-position 0px
.type-tab-line
  position absolute
  bottom 0
  left 0
  width 100%
  height 2px
  background #E0567A
  display none
.type-tab-txt
  position relative
  display inline-block

.type-tab
  display inline-block
  vertical-align middle
  line-height 30px
  padding 0 20px 0 0
  margin-right 0px
  font-size 14px
  cursor pointer
  &:hover
  &.active
    color var(--text-light)
  &.active
    .type-tab-line
      display inline-block

.is-transporting
  .type-tab.sftp
    .type-tab-line
      display inline-block
      background linear-gradient(to right, var(--success) 0%, var(--main) 25%, var(--error) 50%, var(--primary) 75%, var(--success) 100%)
      animation: rotate 60s infinite linear
.disable-ssh
  .type-tab.ssh
    display none

.sessions
  position absolute
  background var(--main)
.session-wrap
  display none
  position absolute
  overflow hidden
  z-index 3
  padding-top 42px
  box-shadow 0px 0px 1px 1px var(--main-darker)
  &.session-batch-active
    display block

.term-sftp-box
  height 100%
.web-session-wrap
  height 100%
  background var(--main)
  overflow hidden
  display flex
  flex-direction column
.web-session-content
  flex 1
  min-height 0
  overflow hidden
.session-v-info
  line-height 30px
.vnc-scroll-wrapper
  position relative
  background var(--main)
  z-index 299
  &::-webkit-scrollbar
    width 16px
    height 16px
    background var(--main-darker)
  &::-webkit-scrollbar-track
    background var(--main-darker)
    box-shadow inset 0 0 5px var(--main-darker)
  &::-webkit-scrollbar-thumb
    background var(--primary)
    border-radius 0
  &::-webkit-scrollbar-corner
    background var(--main-darker)

.not-split-view > .ant-splitter-bar .ant-splitter-bar-dragger
  display none

.terminal-control:not(.mobile-session-control)
  display flex
  align-items center
  height 42px
  background #10141A
  border-bottom 1px solid var(--border-color)
  padding 0 10px
  gap 4px
  .term-sftp-tabs
    border-right 1px solid var(--border-color)
    padding-right 10px
    margin-right 6px
  .term-controls
    margin-left auto
    display flex
    align-items center
    gap 4px

.sess-icon
.spliter
  display inline-flex
  align-items center
  justify-content center
  width 30px
  height 30px
  border-radius 6px
  border 1px solid transparent
  color var(--text-dark)
  transition background-color .12s ease, border-color .12s ease, color .12s ease
  &:hover
    background var(--hover-bg)
    color var(--text)
  &.active
    background rgba(224, 86, 122, .14)
    border-color #E0567A
    color #E0567A