// shortcut-bar
// sits in reserved space at the bottom of the viewport (see layout.jsx +
// .shortcut-bar-on rule below). Height tracks --shortcut-bar-h which the
// component sets from the shortcutBarHeight constant.

.shortcut-bar
  position fixed
  left 0
  right 0
  bottom 0
  height var(--shortcut-bar-h, 44px)
  z-index 400
  display flex
  align-items stretch
  background var(--main)
  border-top 1px solid var(--main-lighter)
  user-select none
  -webkit-user-select none

// A held button now means "keep sending this key", so the platform must not
// treat the hold as its own gesture:
//   - the iOS callout (Copy/Look Up) and Android's text-selection handles
//     would swallow it — same reason .term-wrap suppresses them;
//   - touch-action keeps the hold from turning into a scroll of the page; the
//     bar's own horizontal scroll lives on .shortcut-bar-scroll, which is a
//     separate element, so this only affects the button itself.
.shortcut-bar-btn
  -webkit-touch-callout none
  touch-action manipulation
  flex-shrink 0
  height 32px
  min-width 32px
  padding 0 10px
  display inline-flex
  align-items center
  justify-content center
  border-radius 6px
  border 1px solid var(--main-lighter)
  background var(--main-light)
  color var(--text)
  font-size 13px
  cursor pointer
  white-space nowrap
  &:active
    background var(--primary)
    color var(--primary-contrast)
  &:hover
    color var(--text-light)
  // held down and repeating: keep the :active look for as long as the key is
  // being re-sent, so the user can see the auto-repeat is running
  &.repeating
    background var(--primary)
    color var(--primary-contrast)

.shortcut-bar-fixed
  display flex
  align-items stretch
  flex-shrink 0
  border-right 1px solid var(--main-lighter)

.shortcut-bar-icon-btn
  width 44px
  display flex
  align-items center
  justify-content center
  background transparent
  border none
  color var(--text)
  cursor pointer
  font-size 16px
  -webkit-touch-callout none
  touch-action manipulation
  &:active
    background var(--main-lighter)
  &:hover
    color var(--text-light)

.shortcut-bar-scroll
  flex 1
  display flex
  align-items center
  gap 6px
  padding 0 8px
  overflow-x auto
  overflow-y hidden
  scrollbar-width none
  -webkit-overflow-scrolling touch
  // a press that turns into a drag is a scroll of the button row, which is
  // exactly what this container does — the hold itself is handled in JS
  touch-action pan-x
  &::-webkit-scrollbar
    display none

// while the bar is visible, lift the footer + reserve space so nothing is
// covered (terminal area is shrunk by layout.jsx via store.shortcutBarVisible;
// --shortcut-bar-kb-offset raises both bar + footer above a page-overlaying
// system input panel on iOS / HarmonyOS)
.shortcut-bar-on
  .main-footer
    bottom calc(var(--shortcut-bar-h, 44px) + var(--shortcut-bar-kb-offset, 0px))
  .remote-monitor-bar
    bottom calc(var(--shortcut-bar-h, 44px) + var(--shortcut-bar-kb-offset, 0px) + 36px)
  // the right panel stacks on the footer exactly like the monitor bar, so it
  // needs the same lift. Pinned is excluded: a pinned panel is a full-height
  // dock and owns bottom 0. Mobile is excluded as well: there the panel is a
  // full-screen drawer that covers the footer on purpose (mobile.styl).
  &:not(.is-mobile)
    .right-side-panel:not(.right-side-panel-pinned)
      bottom calc(var(--shortcut-bar-h, 44px) + var(--shortcut-bar-kb-offset, 0px) + 36px)
  // A pinned panel is still a dock, but it yields to the shortcut bar rather
  // than the other way round: the bar is z-index 400 and spans the full
  // viewport width by design (it ignores the left sidebar too), so it would
  // otherwise paint over the dock's bottom edge. The dock stops above the bar
  // only — the footer sits beside the dock, not below it.
  .right-side-panel.right-side-panel-pinned
    bottom calc(var(--shortcut-bar-h, 44px) + var(--shortcut-bar-kb-offset, 0px))
  .qm-wrap-tooltip
    bottom calc(var(--footer-stack-height, 36px) + var(--shortcut-bar-h, 44px) + var(--shortcut-bar-kb-offset, 0px))

// --- edit modal -----------------------------------------------------------

.shortcut-edit-wrap
  .custom-modal-content
    max-width 92vw
.shortcut-edit-section
  margin-bottom 16px
  &:last-child
    margin-bottom 0
.shortcut-edit-section-title
  margin-bottom 8px
  color var(--text)
  font-weight bold
  font-size 13px

.shortcut-active-list
  display flex
  flex-wrap wrap
  gap 6px
  min-height 48px
  padding 8px
  border 1px dashed var(--main-lighter)
  border-radius 6px
  background var(--main-dark)
.shortcut-active-empty
  color var(--text-dark)
  font-size 12px
  width 100%
  text-align center
  line-height 32px

.shortcut-active-item
  display inline-flex
  align-items center
  gap 4px
  height 30px
  padding 0 4px 0 10px
  border-radius 6px
  background var(--main-light)
  border 1px solid var(--main-lighter)
  color var(--text)
  font-size 13px
.shortcut-active-label
  white-space nowrap
.shortcut-active-remove
  display flex
  align-items center
  justify-content center
  width 20px
  height 20px
  border none
  background transparent
  color var(--text-dark)
  border-radius 4px
  cursor pointer
  font-size 11px
  &:hover
    color var(--error)
    background var(--main-lighter)

.shortcut-candidate-list
  display flex
  flex-wrap wrap
  gap 6px
  max-height 180px
  overflow-y auto
  padding 4px
.shortcut-candidate-item
  height 30px
  min-width 34px
  padding 0 10px
  display inline-flex
  align-items center
  justify-content center
  border-radius 6px
  border 1px solid var(--main-lighter)
  background var(--main)
  color var(--text)
  font-size 13px
  cursor pointer
  &:active
    background var(--main-lighter)
  &:hover
    color var(--text-light)
  &.added
    opacity 0.45
    cursor default

.shortcut-custom-form
  display flex
  gap 8px
  align-items center
  flex-wrap wrap
  position relative
.shortcut-search-input
  flex 1
  min-width 160px
.shortcut-custom-input
  flex 1
  min-width 120px
.shortcut-custom-select
  flex 1
  min-width 120px
  width 120px
.shortcut-custom-key
  min-width 110px
  width 110px
.shortcut-custom-add
  height 32px
  white-space nowrap

.shortcut-edit-footer
  justify-content space-between
  width 100%
