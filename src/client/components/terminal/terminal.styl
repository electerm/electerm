
.terms-box
  background var(--main)
  position relative
.loading-wrapper
  padding 30px
  z-index 100
.term-search-box
  position absolute
  right 5px
  top 5px
  z-index 30

.terminal-control
  background var(--main)
  line-height 32px
  padding 0 10px

.terms-box
  position relative
.term-wrap
  background var(--main)
  position absolute

.vertical
  .term-wrap.not-first-term
    border-top 1px solid var(--main-lighter)
.horizontal
  .term-wrap.not-first-term
    border-left 1px solid var(--main-lighter)

#container
  .xterm
    background transparent
  .xterm-viewport
    background-color transparent !important
  // xterm's DOM renderer paints the background of selected text cells directly
  // on the <span> as an opaque 6-digit hex (dropping alpha), while empty cells
  // use the translucent .xterm-selection overlay behind the rows. xterm marks
  // those spans with .xterm-decoration-top ("rendered above the selection"),
  // so neutralise that inline background to let the corrected selection overlay
  // show through uniformly across both empty and text cells.
  .xterm-decoration-top
    background-color transparent !important
  .xterm-screen::before
    content ''
    position absolute
    top 0
    left 0
    width 100%
    height 100%
    background-repeat no-repeat
    background-position center
    background-color transparent !important

// Full-screen plain-text view of the buffer, opened from the touch context
// menu (see terminal-select-text.jsx) so the platform's own selection handles
// and Copy callout can be used instead of xterm's canvas.
//
// 900 clears the touch shortcut bar (400) and the terminal panes, while
// staying below antd's modal (1000) and message (1010) layers so a "copied"
// toast still shows up over this panel.
//
// The callout/user-select resets are load-bearing, not decoration: the
// component is portalled onto <body>, but `.term-wrap` switches off
// -webkit-touch-callout for the terminal's own gestures and the property is
// inherited — if this panel is ever rendered in place again, without the
// resets the native Copy callout would never appear on the textarea.
.terminal-select-text
  position fixed
  left 0
  top 0
  width 100%
  height 100%
  z-index 900
  display flex
  flex-direction column
  background var(--main)
  color var(--text)
  -webkit-touch-callout default
  -webkit-user-select text
  user-select text

.terminal-select-text-bar
  flex-shrink 0
  display flex
  align-items center
  justify-content space-between
  height 40px
  padding 0 10px
  font-size 14px
  background var(--main-lighter)
  .terminal-select-text-btns
    a
      margin-left 16px
      color var(--text)
      &:hover
        color var(--text-light)

.terminal-select-text-area
  flex 1
  width 100%
  margin 0
  padding 8px 10px
  border 0
  outline none
  resize none
  background var(--main)
  color var(--text)
  font-family monospace
  font-size 13px
  line-height 1.4
  -webkit-touch-callout default
  -webkit-user-select text
  user-select text

.terminal-normal-buffer
  position absolute
  left 0
  top 0
  width 100%
  background var(--main)
  color var(--text)
  box-shadow 0px 3px 3px 0px var(--main-lighter)
  z-index 66
  padding-bottom 32px
.terminal-normal-buffer-body
  overflow-y scroll
  max-height 300px
.terminal-normal-buffer-close
  cursor pointer
  font-size 14px
  color var(--text)
  &:hover
    color var(--text-light)
.terminal-normal-buffer-footer
  position absolute
  left 0
  top calc(100% - 32px)
  width 100%
  height 32px
  line-height 32px
  box-shadow 0px -3px 3px 0px var(--main)
  background var(--main-lighter)
.batch-input-wrap
  width calc(100% - 80px)

.terminal-suggestions-wrap
  position absolute
  z-index 100
  max-height 300px
  max-width 300px
  min-width 200px
  box-shadow 0px 0px 3px 3px var(--main-lighter)
  display flex
  flex-direction column
  background var(--main)
  border-radius 4px
  &.reverse .terminal-suggestions-list
    border-top 1px solid var(--main-lighter)
    border-bottom none

.terminal-suggestions-list
  flex 1
  overflow-x hidden
  overflow-y auto
  max-height 268px
  max-width 300px
  border-bottom 1px solid var(--main-lighter)

.terminal-suggestions-sticky
  flex-shrink 0
  height 32px
  padding 0 10px
  line-height 32px

.suggestion-item
  display flex
  align-items center
  padding 5px 10px
  cursor pointer
  color var(--text)
  &:hover
    background-color var(--main-lighter)
    .suggestion-delete
      visibility visible

.suggestion-command
  flex-grow 1
  white-space nowrap
  overflow hidden
  text-overflow ellipsis

.suggestion-type
  margin-left 5px
  font-size 0.8em
  color var(--text)
  &:hover
    color var(--success)

.suggestion-hint
  margin-left 5px
  font-size 0.8em
  color var(--text-light, #888)
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  max-width 150px

.suggestion-delete
  margin-left 5px
  visibility hidden

.term-search-bar
  position absolute
  right 0
  top 0
  bottom 0
  background transparent
  width 16px
.paste-text
  max-height 200px
  overflow-y scroll

.terminal-reconnect-overlay
  position absolute
  bottom 6px
  right 12px
  font-size 11px
  color rgba(255, 255, 255, 0.55)
  pointer-events none
  z-index 110

.terminal-error-handle
  position absolute
  left 0
  top 0
  z-index 100
  background var(--main)
  max-width calc(100% - 24px)

.terminal-fontsize-reset
  position absolute
  left 8px
  bottom 4px