.drop-file-modal
  .custom-modal-body
    padding 16px 24px

  .ant-select
    width 100%

.drop-file-list
  display grid
  gap 6px
  margin 0 0 16px
  padding 0
  max-height 30vh
  overflow auto
  list-style none

  li
    display flex
    align-items baseline
    gap 8px
    overflow-wrap anywhere
