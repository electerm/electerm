.bookmark-appearance-trigger
  display inline-flex
  align-items center
  border 0
  padding 0
  background transparent
  cursor pointer
  &:focus-visible
    outline 2px solid var(--primary)
    outline-offset 2px

.bookmark-appearance
  width 420px
  max-width calc(100vw - 40px)
  .ant-tabs-nav
    margin-top -8px

.bookmark-icon-editor
  width 100%

.bookmark-icon-hint
  opacity .75

.bookmark-icon-preview
  display flex
  align-items center
  gap 12px
  min-height 40px
  .bookmark-icon
    width 32px
    height 32px
