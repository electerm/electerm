.color-picker-unit
  display inline-block
  padding 5px
  margin-right 5px
  margin-bottom 5px
  border 1px solid #ccc
  border-radius 5px
  cursor pointer
  background #fff
  width 92px
.color-picker-box
  width 420px
  // the popover is portaled to the body, a 420px box simply falls off a phone
  // screen (measured: the swatch list and the antd picker still fit at 280px)
  max-width calc(100vw - 40px)

.color-picker-defaults
  width 200px
.color-picker-choose
  width 18px
  height 18px
  cursor pointer