.cmd-history-popover-content
  position relative
  max-height 300px
  width 300px
  // deliberately not clipped: the item action menu is a child of the panel, but
  // it hangs below its row and may reach past the panel's edge
  display flex
  flex-direction column
  // Docked in the right side panel the panel *is* the container, so the history
  // fills it instead of sizing itself like a popup. The parent
  // (.right-side-panel-content) is an absolutely positioned box with top and
  // bottom set, so 100% resolves to a real height and the list scrolls inside
  // it rather than scrolling the panel.
  &.cmd-history-in-panel
    width 100%
    max-height none
    height 100%
.cmd-history-search
  flex-shrink 0
  position sticky
  top 0

.cmd-history-header
  flex-shrink 0
  display flex
  align-items center
  justify-content space-between
  padding-bottom 8px

.cmd-history-header-actions
  display flex
  align-items center
  gap 6px

// The footer trigger stays lit while the history is docked in the right panel,
// same contract as the info and AI icons
.cmd-history-trigger
  &.active
    color var(--success)
    .anticon
      color var(--success)

.cmd-history-sort
  display flex
  align-items center
  gap 6px

.cmd-history-sort-label
  user-select none

.cmd-history-move-icon
  font-size 14px
  padding 4px
  cursor pointer
  &:hover
    color var(--primary)

.cmd-history-clear-icon
  font-size 14px
  padding 4px
  cursor pointer
  &:hover
    color red

.cmd-history-list
  overflow-x hidden
  overflow-y auto
  flex 1
  min-height 0

.cmd-history-item
  display flex
  align-items center
  justify-content space-between
  padding 4px 8px
  cursor pointer
  &:hover
    background var(--main-lighter)
  // keep the row actions visible while its action menu is open, otherwise the
  // menu trigger would be hidden (display none) and the popup would lose its
  // anchor when the mouse moves onto the menu
  &.menu-open
    background var(--main-lighter)
    .cmd-history-item-actions
      display flex

.cmd-history-item-text
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
  flex 1
  min-width 0

.cmd-history-item-count
  font-size 12px
  color var(--text-color-secondary)
  padding 0 4px
  flex-shrink 0

.cmd-history-item-actions
  display none
  flex-shrink 0
  gap 4px
  align-items center
  .cmd-history-item:hover &
    display flex

.cmd-history-item-more
  cursor pointer
  padding 2px 4px
  &.active
    color var(--primary)

.cmd-history-item-copy
  cursor pointer
  padding 2px 4px
  &:hover
    color blue

// The item action menu is part of this panel: it is rendered inside
// `.cmd-history-popover-content` (not in a body-level portal) so that it can
// never outlive the popover. It hangs below the row whose ⋯ icon was clicked —
// the component lifts it above that row when it would fall off the window.
.cmd-history-item-menu
  position absolute
  right 8px
  z-index 10
  min-width 156px
  padding 4px 0
  border-radius 4px
  background var(--main)
  border 1px solid var(--main-darker)
  box-shadow 0 2px 8px rgba(0, 0, 0, 0.35)

.cmd-history-menu-item
  display flex
  align-items center
  gap 8px
  padding 5px 10px
  cursor pointer
  white-space nowrap
  &:hover
    background var(--main-lighter)
  &.danger
    color var(--error)

.cmd-history-menu-icon
  font-size 13px
  line-height 1

.cmd-history-menu-label
  flex 1

.multi-tab-run-cmd
  font-size 12px
  padding 6px 8px
  margin-bottom 10px
  border-radius 4px
  background var(--main-lighter)
  word-break break-all
  max-height 96px
  overflow-y auto

// Narrow screens: the popup is aligned to the history trigger (placement
// topLeft) and is 324px wide, while the footer trigger sits within the first
// ~96px of the screen (43px icon bar + footer margin + the icons before it), so
// below ~420px the popup's right edge would fall outside the window. antd's
// auto-shift does not correct it, so pin the popup to the viewport instead.
// Matched by its content: the popup lives in a body-level portal, so neither
// the component tree nor an antd popup class reaches it reliably.
@media (max-width: 420px)
  .ant-popover:has(.cmd-history-popover-content)
    // rc-trigger writes `inset: auto auto 40px <trigger left>px` inline
    left 0px !important
    // pinned to the viewport, the arrow no longer points at the trigger
    .ant-popover-arrow
      display none
  .cmd-history-popover-content
    // popup = content + 24px container padding; keep 8px on both sides
    width 100%

// Touch devices have no hover, so the row actions (count / copy / ⋯ menu)
// would never be reachable — feature-detect instead of sniffing the UA
@media (pointer: coarse)
  .cmd-history-item-actions
    display flex
