.main-footer
  background var(--main)
  height var(--footer-stack-height)
  position absolute
  left calc(var(--left-side-bar-width, 43px) + 1px)
  right 0
  bottom 0
  z-index 200
.pinned
  .main-footer
  .qm-wrap-tooltip
    left 343px

.terminal-footer-flex
  display flex
  height 100%
  align-items center
  .monitor-toggle
    align-self center
    margin-left 8px
    width 28px
    height 22px
    flex-shrink 0
    border 0
    border-radius 3px
    background transparent
    color var(--text)
    cursor pointer
    &:hover, &[aria-pressed=true]
      color var(--primary)
      background var(--main-light)
  .terminal-footer-unit .ant-select-selector .ant-select-selection-placeholder
    line-height 24px
.terminal-footer-unit
  margin-left 10px
  line-height 22px
  textarea.ant-input
    min-height 26px
    height 26px
    margin-bottom -2px
    resize none
    &::-webkit-scrollbar
      width 0

.terminal-footer-center
  flex-grow 1
.terminal-footer-info
  margin-right 10px
.terminal-footer-history
  display flex
  align-items center
.terminal-footer-qm
  // Q is now an icon-only button (5px internal padding); reduce left
  // margin so the history icon stays roughly equidistant from AI and Q
  margin-left 3px
.terminal-footer-triggers
  display flex
  align-items center
.batch-input-outer
  position relative
  .bi-full
    display none
  &.bi-show
    // hide the trigger while the popup is open so we don't show two
    // "batch input" fields at once (desktop trigger is an input-shaped affordance)
    .bi-compact
      display none
    .bi-full
      display flex
      flex-direction column
      gap 6px
      position absolute
      bottom 100%
      left 0
      z-index 1000
      background var(--main)
      padding 8px 10px
      box-shadow 0 -2px 8px rgba(0, 0, 0, 0.2)
      border-radius 4px 4px 0 0
      min-width 360px
.batch-input-holder
  width 100px
// a terminal button in the batch input and "run in terminals" lists: long
// titles end in an ellipsis instead of running past the popup, and the
// button's title attribute still shows the full name on hover
.batch-tab-item
  display inline-flex
  max-width 100%
  .batch-tab-title
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
