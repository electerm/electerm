
.item-list-wrap
  overflow-y scroll
  &::-webkit-scrollbar
    width 0
.list-item-title
  flex 1
  min-width 0

.list-item-actions
  display none
  flex none
  align-items stretch
  > *
    display inline-flex
    align-items center
    justify-content center
    width 24px

.item-list-unit:hover .list-item-actions
.list-item-actions:has(.ant-tooltip-open, .ant-popover-open)
.is-touch-device .list-item-actions
  display flex

.item-list-unit
  display flex
  position relative
  margin-bottom 1px
  cursor pointer
  line-height 1.8
  &.active
    background var(--primary)
    color var(--primary-contrast)
  &.current
    font-weight bold
  &:hover
    background var(--primary)
    color var(--primary-contrast)
.setting-tabs-setting .list-item-actions .list-item-remove
  display none
