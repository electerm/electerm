

.close-setting-wrap
  position absolute
  top 70px
  font-size 16px
  cursor pointer
  z-index 889
  right 20px
  &:hover
    color var(--success)
.alt-close-setting-wrap
  left 20px
  right auto
.batch-op-wrap .close-setting-wrap
  top 40px
  right 30px
.setting-row
  position absolute
  top 127px
  overflow-y scroll
.setting-row-left
  left 0
  width 340px
  bottom 0
  padding 20px 0 20px 20px
  display flex
  flex-direction column
  .model-bookmark-tree-wrap
    flex 1
    display flex
    flex-direction column
    overflow hidden
    min-height 0
.setting-row-right
  left 340px
  right 0
  bottom 0
  top 129px
  padding 20px
  display flex
  flex-direction column
  overflow hidden
  min-height 400px
.setting-col-content
  flex 1
  overflow-y auto
  min-height 0
.setting-col-placeholder
  flex-shrink 0
  display flex
  justify-content flex-end
  .carbonads-wrap
    margin 8px 0 0
.setting-tabs-bookmarks
  .setting-row-left
    width 440px
  .setting-row-right
    left 483px
.setting-tabs
  position absolute
  z-index 4
  left 0
  top 0
  right 0
  padding 55px 20px 0 50px
.setting-col
  ::-webkit-scrollbar
    width 0
@media (max-width: 800px)
  .setting-col
    position fixed
    top 128px
    bottom 0
    left var(--left-side-bar-width, 43px)
    right 0
    display flex
    flex-direction column
    overflow hidden
  .setting-row
    position static
    top auto
  // right close button is redundant with the left one on mobile
  .close-setting-wrap:not(.alt-close-setting-wrap)
    display none
  // menu view by default: the left col list fills the panel
  .setting-row-left
    flex 1
    min-height 0
    overflow-y auto
    position static
    top auto
    bottom auto
    left auto
    width auto
    padding 10px
  .setting-row-right
    display none
    position static
    top auto
    right auto
    bottom auto
    left auto
    width auto
    padding 10px
  // content view: fixed breadcrumb on top, right col content scrolls below
  .setting-view-content
    .setting-mobile-back
      display flex
    .setting-row-left
      display none
    .setting-row-right
      display flex
      flex-direction column
      flex 1
      min-height 0
      overflow hidden
      position static
      top auto
      right auto
      bottom auto
      left auto
      width auto
      padding 10px
    .setting-col-content
      flex 1
      overflow-y auto
      min-height 0
  .setting-tabs-bookmarks
    .setting-row-left
      width auto
    .setting-row-right
      left auto

// breadcrumb used on the narrow (mobile) content view; hidden by default and
// re-shown by `.setting-view-content` inside the 800px media query above
.setting-mobile-back
  display none
  flex-shrink 0
  align-items center
  gap 4px
  padding 8px 10px
  background var(--main)
  border-bottom 1px solid var(--main-light)
  z-index 10
.setting-mobile-back-btn
  display flex
  align-items center
  gap 4px
  height 24px
  padding 0 6px
  font-size 13px
  color var(--primary)
  background transparent
  border 0
  border-radius 4px
  cursor pointer
  &:hover
    background var(--primary)
    color var(--primary-contrast)
.setting-mobile-back-sep
  color var(--text-dark)
  font-size 13px
  line-height 24px
  padding 0 2px
.setting-mobile-back-current
  font-size 13px
  min-width 0
  max-width 60%