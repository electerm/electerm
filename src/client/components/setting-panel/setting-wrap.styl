.custom-drawer.setting-wrap
  left 0
  --settings-header 48px
  .custom-drawer-content-wrapper
    overflow hidden
// Native drag regions ignore DOM stacking. A covered tab or toolbar must
// never claim clicks through the settings panel in a frameless window.
.setting-wrap ~ #outside-context
  .app-drag, .terminal-toolbar
    -webkit-app-region no-drag !important
.close-setting-wrap
  position absolute
  top 6px
  right 12px
  width 32px
  height 32px
  display grid
  place-items center
  padding 0
  border 0
  border-radius 3px
  background transparent
  color var(--text)
  font-size 16px
  cursor pointer
  z-index 5
  -webkit-app-region no-drag
  &:hover, &:focus-visible
    background var(--main-dark)
.setting-row
  position absolute
  top var(--settings-header)
  overflow-y scroll
.setting-row-left
  left 0
  width 27%
  bottom 0
  padding 12px
  display flex
  flex-direction column
  .model-bookmark-tree-wrap
    flex 1
    display flex
    flex-direction column
    overflow hidden
    min-height 0
.setting-row-right
  left 27%
  right 0
  bottom 0
  padding 12px 18px
  border-left 1px solid var(--main-light)
  display flex
  flex-direction column
  overflow hidden
  min-height 0
.setting-col-content
  flex 1
  overflow-y auto
  min-height 0
.setting-col-placeholder
  flex-shrink 0
  display flex
  justify-content flex-end
  .carbonads-wrap
    margin 8px 0 0
.setting-tabs
  position absolute
  z-index 4
  left 0
  top 0
  right 0
  height var(--settings-header)
  box-sizing border-box
  padding 5px 54px 0 12px
  background var(--main-dark)
  .ant-tabs-nav
    margin 0
.is-mac.not-system-ui .setting-tabs
  padding-left 78px
.setting-col
  ::-webkit-scrollbar
    width 0
@media (max-width: 800px)
  .setting-col
    position absolute
    top var(--settings-header)
    bottom 0
    left 0
    right 0
    display flex
    flex-direction column
    overflow hidden
  .setting-row
    position static
    top auto
  // menu view by default: the left col list fills the panel
  .setting-row-left
    flex 1
    min-height 0
    overflow-y auto
    position static
    top auto
    bottom auto
    left auto
    width auto
    padding 10px
  .setting-row-right
    display none
    position static
    top auto
    right auto
    bottom auto
    left auto
    width auto
    padding 10px
  // content view: fixed breadcrumb on top, right col content scrolls below
  .setting-view-content
    .setting-mobile-back
      display flex
    .setting-row-left
      display none
    .setting-row-right
      display flex
      flex-direction column
      flex 1
      min-height 0
      overflow hidden
      position static
      top auto
      right auto
      bottom auto
      left auto
      width auto
      padding 10px
    .setting-col-content
      flex 1
      overflow-y auto
      min-height 0
  .setting-tabs-bookmarks
    .setting-row-left
      width auto
    .setting-row-right
      left auto

// breadcrumb used on the narrow (mobile) content view; hidden by default and
// re-shown by `.setting-view-content` inside the 800px media query above
.setting-mobile-back
  display none
  flex-shrink 0
  align-items center
  gap 4px
  padding 8px 10px
  background var(--main)
  border-bottom 1px solid var(--main-light)
  z-index 10
.setting-mobile-back-btn
  display flex
  align-items center
  gap 4px
  height 24px
  padding 0 6px
  font-size 13px
  color var(--primary)
  background transparent
  border 0
  border-radius 4px
  cursor pointer
  &:hover
    background var(--primary)
    color var(--primary-contrast)
.setting-mobile-back-sep
  color var(--text-dark)
  font-size 13px
  line-height 24px
  padding 0 2px
.setting-mobile-back-current
  font-size 13px
  min-width 0
  max-width 60%
