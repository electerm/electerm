// Preset row: the "Presets" label and the provider select share one line.
// antd's Space wraps every child in a `.ant-space-item`, and that wrapper — not
// the child — is the flex item, so the flex behaviour has to be set on the
// wrappers. Put `flex` on the Select itself and it is silently ignored, which
// makes the row's overflow land on the label: at 480px wide the label is
// squeezed into a 17px column and wraps onto four lines.
.ai-preset-row
  max-width 400px
  .ant-space-item:first-child
    // the label keeps its full text width and never wraps or shrinks
    flex none
    white-space nowrap

  .ant-space-item:last-child
    // the select takes the rest of the line, shrinking to nothing if it must
    flex 1
    min-width 0

    .ant-select
      width 100%
