.ai-chat-container
  height 100%
  display flex
  flex-direction column

.ai-chat-history
  flex-grow 1
  min-height 0
  &::-webkit-scrollbar
    width 0
.ai-history-wrap
  width 100%
  overflow-y auto
  overflow-x hidden

.chat-history-item
  max-width 48rem
  margin 0 auto
  padding 16px 12px 8px
  overflow-wrap anywhere

.ai-user-message
  display flex
  align-items center
  justify-content flex-end
  gap 4px
  margin-bottom 14px
  > button
    color var(--text-dark)
    flex-shrink 0

.ai-prompt-bubble
  max-width 86%
  min-width 0
  padding 8px 13px
  border-radius 16px 16px 4px 16px
  background unquote('color-mix(in srgb, var(--text) 9%, transparent)')
  color var(--text)
  font-size 13px
  line-height 1.5

.ai-prompt-text
  white-space pre-wrap

.ai-prompt-menu
  max-width unquote('min(320px, 80vw)')
  overflow-wrap anywhere
  font-size 12px
  time
    color var(--text-dark)

.ai-prompt-menu-actions
  display flex
  gap 6px
  margin-top 8px

.ai-stream-output
  margin-top 8px
  color var(--text)
  font-size 14px
  line-height 1.65

.ai-answer-text
  > :first-child
    margin-top 0
  > :last-child
    margin-bottom 0
  p
    margin 0 0 0.75em
  ul, ol
    padding-inline-start 1.6em
  pre
    white-space pre-wrap
  .code-block
    background unquote('color-mix(in srgb, var(--text) 5%, transparent)')
    border-radius 8px
    padding 8px 10px
    pre
      margin 0

.copy-icon,
.code-action-icon
  color var(--text-dark)
  font-size 14px
  &:hover
    color var(--primary)

.code-block-actions
  display flex
  justify-content flex-end

.ai-output-actions
  display flex
  align-items center
  gap 9px
  margin-top 8px
  min-height 20px

.ai-answer-provider
  color var(--text-dark)
  font-size 11px

// markdown (react-markdown, GFM) tables in the AI answer. Just enough to be a
// usable table, using the theme's own colours.
// display:block + overflow-x:auto is the load bearing part: .ai-history-wrap is
// overflow-x hidden, so a table wider than the panel would otherwise be clipped
// with no way to reach its right hand columns. width:max-content keeps it
// shrink-to-fit while it still fits.
.ai-stream-output
  table
    display block
    width max-content
    max-width 100%
    overflow-x auto
    border-collapse collapse
  th,
  td
    border 1px solid var(--main-darker)
    padding 4px 8px
    text-align left


.ai-chat-input
  box-sizing border-box
  flex none
  width 100%
  max-width 48rem
  max-height 68%
  margin 0 auto
  padding 8px clamp(4px, 2%, 12px) 2px
  gap 4px
  overflow-y auto

.ai-chat-composer
  padding 10px 10px 8px
  border 1px solid unquote('color-mix(in srgb, var(--text) 20%, transparent)')
  border-radius 16px
  background unquote('color-mix(in srgb, var(--text) 4%, var(--main))')
  &:focus-within
    border-color var(--primary)

  .ai-chat-textarea
    display block
    padding 2px 3px
    border 0
    outline none
    box-shadow none
    background transparent
    color var(--text)
    font-size 14px
    line-height 1.5
    resize none
    &::placeholder
      color var(--text-dark)

.ai-chat-terminals
  margin-top 6px
  color var(--text-dark)
  > button
    flex none

.ai-chat-controls
  flex 1
  min-width 0
  .ant-select
    min-width 0
    max-width 100%

.ai-chat-footer
  color var(--text-dark)

.ai-chat-config-controls
  min-width 0
  max-width 100%
  .ai-chat-config-select
    min-width 0

.ai-chat-toolbar
  margin-inline-start auto
  justify-content flex-end
  flex none
  .ant-btn-text[aria-pressed='true'],
  .ai-auto-compress-on
    color var(--primary)
    background unquote('color-mix(in srgb, var(--primary) 10%, transparent)')

.ai-disclamer
  font-size 12px

.code-block
  width 100%
  pre
    white-space pre-wrap
    word-wrap break-word
    overflow-x auto
    max-width 100%
  code
    white-space pre-wrap
    word-break break-all

.ai-chat-attachments
  max-height 5em
  overflow-y auto
  margin-bottom 6px
  .ant-tag
    display inline-flex
    align-items center
    gap 4px
    margin 0
    max-width 100%
    border-radius 8px
  .ai-attachment-name
    min-width 0
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

.ai-chat-item-attachments
  display flex
  flex-wrap wrap
  gap 4px
  .ant-tag
    margin 0
    max-width 100%
    overflow hidden
    text-overflow ellipsis

.ai-prompt-text + .ai-chat-item-attachments
  margin-top 6px

.ai-attachment-dragover
  outline 2px dashed var(--primary)
  outline-offset -2px

.ai-chat-sessions-wrap
  width 100%
  height 100%
  overflow-y auto
  overflow-x hidden
  padding 4px 0

.ai-chat-sessions-toolbar
  padding 0 4px 8px

.ai-chat-session-item
  display flex
  align-items center
  padding 8px 10px
  margin-bottom 6px
  border 1px solid var(--main-darker)
  border-radius 4px
  cursor pointer
  transition all 0.2s
  &:hover
    border-color #1890ff
    background var(--main-dark)
    .ai-chat-session-delete
      opacity 1
  &.active
    border-color #1890ff
    background rgba(24, 144, 255, 0.06)

.ai-chat-session-content
  flex 1
  min-width 0
  overflow hidden

.ai-chat-session-header
  margin-bottom 4px

.ai-chat-session-preview
  font-size 13px
  font-weight 500
  white-space nowrap
  overflow hidden
  text-overflow ellipsis

.ai-chat-session-meta
  font-size 12px
  color var(--text-color-2)

.ai-chat-session-time
  flex-shrink 0

.ai-chat-session-count
  flex-shrink 0
  margin-left 8px

.ai-chat-session-delete
  opacity 0
  flex-shrink 0
  margin-left 8px
  transition opacity 0.2s

.ai-chat-sessions-empty
  height 100%
  min-height 200px

.ai-transcript-button,
.ai-activity > summary
  display inline-flex
  align-items center
  gap 6px
  padding 4px 0
  border 0
  background transparent
  color var(--text-dark)
  font inherit
  font-size 12px
  text-align start
  cursor pointer
  &:hover, &:focus-visible
    color var(--text)

.ai-activity > summary
  max-width 100%
  &::-webkit-details-marker
    display none

.ai-disclosure-arrow
  font-size 9px
  flex none

.ai-activity[open] > summary .ai-disclosure-arrow,
.agent-tool-header[aria-expanded='true'] .ai-disclosure-arrow
  transform rotate(90deg)

.ai-current-tool
  overflow hidden
  white-space nowrap
  text-overflow ellipsis

.ai-activity-log
  margin 4px 0 10px 4px
  padding-left 12px
  border-left 1px solid var(--main-darker)
  color var(--text-dark)
  font-size 12px

.ai-activity-note
  white-space pre-wrap
  margin-bottom 6px

.agent-tool-header
  width 100%
  padding 5px 0

.agent-tool-name
  flex 1
  min-width 0

.agent-tool-status
  font-size 11px

.agent-tool-status-error
  color var(--error)

.ai-auto-compress-badge
  color var(--text-dark)
  font-size 12px

.agent-tool-detail
  padding 0 0 6px 18px

.agent-tool-label
  margin 6px 0 3px
  font-size 12px

.agent-tool-pre-wrap
  position relative

.agent-tool-copy
  position absolute
  top 5px
  right 6px
  z-index 1

.agent-tool-pre
  background var(--main-dark)
  padding 6px 26px 6px 8px
  border-radius 3px
  font-size 12px
  max-height 200px
  overflow-y auto
  white-space pre-wrap
  word-break break-all
  margin-bottom 0

.ai-chat-empty
  position relative
  width 100%
  min-height 150px
  display flex
  align-items center
  justify-content center
  overflow hidden
  padding 10px 0

.ai-chat-empty-inner
  text-align center
  padding 0 12px
  max-width 100%

.ai-chat-watermark
  width 86%
  max-width 400px
  aspect-ratio 766 / 266
  margin 0 auto 14px
  background-color var(--text)
  opacity 0.55
  pointer-events none
  user-select none
  -webkit-mask-image var(--ai-watermark)
  mask-image var(--ai-watermark)
  -webkit-mask-repeat no-repeat
  mask-repeat no-repeat
  -webkit-mask-position center
  mask-position center
  -webkit-mask-size contain
  mask-size contain

.ai-chat-empty-title
  font-size 15px
  font-weight 500

.ai-chat-empty-hint
  font-size 12px
  margin-top 4px
  color var(--text-dark)

.ai-chat-empty-examples
  margin-top 14px
  display flex
  flex-direction column
  align-items center
  gap 6px

.ai-chat-empty-example
  max-width 100%
  font-size 12px
  padding 5px 10px
  border 1px solid var(--main-darker)
  border-radius 14px
  color var(--text-dark)
  cursor pointer
  transition all 0.2s
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  &:hover
    border-color var(--primary)
    color var(--text)

.ai-context-indicator
  display flex
  width max-content
  margin-inline-start auto
  margin-bottom 6px
  align-items center
  gap 4px
  font-size 11px
  line-height 1
  color var(--text-dark)
  cursor default
  user-select none

.ai-context-bar
  display inline-block
  width 34px
  height 5px
  border-radius 3px
  background var(--main-darker)
  overflow hidden
  flex-shrink 0

.ai-context-bar-fill
  display block
  height 100%
  border-radius 3px
  background var(--primary)
  transition width 0.2s

.ai-context-count
  color var(--text-dark)
  font-variant-numeric tabular-nums

.ai-context-percent
  font-variant-numeric tabular-nums

.ai-context-warn
  .ai-context-bar-fill
    background var(--warn)
  .ai-context-percent
    color var(--warn)

.ai-context-danger
  .ai-context-bar-fill
    background var(--error)
  .ai-context-percent
    color var(--error)
    font-weight 500

.ai-context-tip
  font-size 12px
  min-width 210px

.ai-context-tip-title
  font-weight 500
  margin-bottom 4px

.ai-context-tip-row
  display flex
  justify-content space-between
  gap 12px

.ai-context-tip-total
  font-weight 500
  border-top 1px solid var(--main-darker)
  margin-top 2px
  padding-top 2px

.ai-context-tip-note
  margin-top 4px
  opacity 0.75

.ai-context-tip-warn
  margin-top 4px
  color var(--warn)
