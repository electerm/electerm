.terminal-info-icon
  color var(--text-dark)
  &:hover
    color var(--text)
.terminal-info-section,
.right-side-panel-content > .remote-monitor-details
  padding 10px 0

.terminal-info-filter-wrap
  display flex
  justify-content flex-end

.terminal-info-filter
  display inline-flex
  align-items center
  justify-content center
  gap 3px
  height 24px
  padding 0 4px
  border 0
  background transparent
  color var(--text-dark)
  font-size 14px
  cursor pointer
  &:hover,
  &:focus-visible
    color var(--text)
  &:focus-visible
    outline 1px solid var(--primary)
    outline-offset 1px

.terminal-info-filter-count
  color var(--text-disabled)
  font-size 11px
  font-variant-numeric tabular-nums

.terminal-info-filter-list
  min-width 140px
  padding 2px 0

.terminal-info-filter-item
  display flex
  align-items center
  gap 6px
  padding 4px 8px
  color var(--text)
  cursor pointer
  &:hover
    background var(--main-light)
  &:focus-visible
    outline 1px solid var(--primary)
    outline-offset -1px

.terminal-info-filter-item-on
  color var(--primary)

.terminal-info-filter-check
  flex-shrink 0
  width 12px
  font-size 10px

.terminal-info-filter-label
  min-width 0
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
