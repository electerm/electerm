.terminal-info-icon
  color var(--text-dark)
  &:hover
    color var(--text)
.info-panel-wrap
  position fixed
  right 0
  top 100px
  bottom 0
  width 500px
  background var(--main)
  border 1px solid var(--main-darker)
  border-radius 5px 0 0 5px
  border-right none
  color var(--text)
  z-index 100
  overflow-y scroll

  .drag-handle
    left 0
    right auto
    display block
.terminal-info-section
  padding 10px 0
.terminal-info-sys
  border-bottom 1px solid var(--main-darker)
  .terminal-info-sys-rows
    display flex
    flex-direction column
    gap 4px
  .terminal-info-sys-row
    display flex
    gap 8px
    align-items baseline
    font-size 12px
  .terminal-info-sys-key
    flex none
    width 80px
    color var(--text-dark)
    text-transform capitalize
  .terminal-info-sys-val
    flex 1
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
.activity-item
  max-height 1.6em
  line-height 1.6
  overflow hidden
  &:hover
    max-height none
.info-panel-wrap-pin
  .toggle-info-panel-wrap
    color var(--success)
