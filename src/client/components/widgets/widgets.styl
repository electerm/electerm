// Widget list, instance detail and custom-widget panels. Where a rule
// overrides setting-panel/list.styl or antd, the reason is noted inline.

.wil-pop-info
  max-width 220px
  word-break break-all

// list.styl parks action icons absolutely at the row's right edge; in flow
// they own their width, so a long title truncates before them, not under them.
.wil-item-actions
  display flex
  flex 0 0 auto
  align-items center
  .list-item-autorun
  .list-item-remove
    position static
    display block
    width 22px
    line-height inherit
    // keep the space while hidden, or the title re-ellipsises on hover
    visibility hidden
.item-list-unit:hover,
.is-touch-device
  .wil-item-actions
    .list-item-autorun
    .list-item-remove
      visibility visible

// column shell and header, shared by instance detail and the UI widget panel
.widget-instance-detail
.custom-widget-panel
  display flex
  flex-direction column
  min-height 0
  height 100%
.wil-head
.cwp-head
  display flex
  align-items center
  justify-content space-between
  gap 8px
  margin-bottom 10px
  flex-shrink 0
.wil-head-title
.cwp-title
  min-width 0
  font-size 14px
.cwp-version
  margin-left 8px
  font-size 11px
  color var(--text-dark)
.cwp-actions
  display flex
  align-items center
  gap 8px
  flex-shrink 0
.cwp-state
  display flex
  align-items center
  gap 5px
  font-size 11px
  color var(--text-dark)
  &::before
    content ''
    width 6px
    height 6px
    border-radius 50%
    background var(--text-disabled)
  &.is-on
    color var(--success)
    &::before
      background var(--success)

.wil-descriptions
  // the log is the point: a long config list shrinks and scrolls instead
  flex 0 1 auto
  min-height 0
  overflow auto
  .ant-descriptions-item-label
    width 90px
    white-space nowrap
  .ant-descriptions-item-content
    word-break break-all
.wil-mono
  font-family monospace
  font-size 12px
.wil-switch
  margin 10px 0 6px
  flex-shrink 0
.wil-pane
  flex 1
  // floor keeps the log readable below a long config list
  min-height 200px
  overflow auto
  padding 6px 8px
  background var(--main-dark)
  border 1px solid var(--main-light)
  border-radius 4px
  font-family monospace
  font-size 12px
  line-height 1.6
.wil-line
  display flex
  gap 6px
  white-space pre-wrap
  word-break break-word
  border-bottom 1px solid var(--main-light)
  &:last-child
    border-bottom 0

.wil-time
.wil-mark
.wil-type
.wil-from
.wil-path
  flex-shrink 0
.wil-msg
  min-width 0
.wil-time
  color var(--text-disabled)
.wil-from
.wil-debug
.wil-info
.wil-empty
  color var(--text-dark)
.wil-log
  color var(--text)
.wil-warn
  color var(--warn)
.wil-error
.wil-fail
  color var(--error)
.wil-ok
  color var(--success)
// .wil-mark inherits the state color from .wil-line
.wil-empty
  padding 6px 0
.wil-path
  margin-top 6px
  font-size 11px
  color var(--text-disabled)

// offer cards (.wac, also used by widget-bookmarks) and result rows (.cwf)
.wac
  flex-shrink 0
  margin 10px 0
  padding 8px 10px
  border 1px solid var(--main-light)
  border-radius 4px
  background var(--main-dark)
.wac-head
  display flex
  align-items center
  gap 8px
  margin-bottom 4px
.wac-title
  font-size 12px
  font-weight 500
.wac-desc
  margin 0 0 6px
  color var(--text-dark)
  font-size 11px
.wac-rows
  display flex
  flex-direction column
  gap 2px
  margin-bottom 8px
.wac-row
.cwf-detail
  display flex
  gap 8px
  align-items flex-start
.wac-row
  font-size 12px
.wac-label
  flex 0 0 90px
  color var(--text-dark)
  white-space nowrap
.cwf-detail-label
  flex 0 0 110px
  color var(--text-dark)
  word-break break-word
.wac-value
.cwf-detail-value
  flex 1
  min-width 0
  display flex
  align-items center
  gap 2px
  font-family monospace
  font-size 12px
  word-break break-all
.wac-secret
.cwf-secret
.cwf-cell
  display flex
  align-items center
  gap 2px
  min-width 0
.wac-secret
.cwf-secret
  max-width 100%
.wac-secret-text
.cwf-secret-text
  min-width 60px
  font-family monospace

.widgets-import-row
  display flex
  align-items center
  // the button is `block` (width 100%); give the help icon its room back
  .ant-btn
    flex 1
    min-width 0
.list-item-widget-error
  position absolute
  right 0
  top 0
  width 24px
  line-height 35px
  text-align center
  color var(--warn)

.cwp-error
  flex-shrink 0
  margin-bottom 10px
  color var(--error)
.cwp-offer
  flex-shrink 0
  max-height 45%
  overflow auto
  margin-bottom 10px
.cwp-frame
  flex 1
  min-height 0
  width 100%
  border 0
  border-radius 4px
  // the document inherits nothing; widget-bridge.js hands it the theme vars
  background var(--main-dark)
  color-scheme inherit

.cwf-desc
  margin-bottom 10px
  color var(--text-dark)
.cwf-result
  margin-top 6px
.cwf-result-head
  margin-bottom 4px
.cwf-details
  display flex
  flex-direction column
  gap 4px
  margin-bottom 10px
.cwf-table
  font-size 12px
  margin-bottom 10px
  .ant-table-cell
    padding 4px 6px
.cwf-buttons
  margin-top 8px
.cwf-json
  font-family monospace
  font-size 12px
  white-space pre-wrap
  word-break break-all
  max-height 240px
  overflow auto
