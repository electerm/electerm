
// hover popover on a running-instance row. A long path makes it wider than the
// list column, and it then spills over the detail panel's heading, so it is
// held to the column and wrapped instead.
.wil-pop-info
  max-width 220px
  word-break break-all

// widget instances list: the auto-run toggle and the delete icon
// (widget-instance.jsx). `setting-panel/list.styl` parks every `.list-item-*`
// action icon absolutely at the row's right edge and reveals it on hover — fine
// for a short title, but this row's title is the point, and the ellipsised text
// ran straight underneath both icons. In flow they own their width instead, so
// the title truncates before them.
.wil-item-actions
  display flex
  flex 0 0 auto
  align-items center
  .list-item-autorun
  .list-item-remove
    position static
    display block
    width 22px
    line-height inherit
    // the space is kept while they are hidden, so the title does not
    // re-ellipsise as the pointer enters the row
    visibility hidden
.item-list-unit:hover
  .wil-item-actions
    .list-item-autorun
    .list-item-remove
      visibility visible
// a touch screen has no hover: the shared `.is-touch-device` rule shows the
// icons there, and this has to undo the `visibility` half too
.is-touch-device
  .wil-item-actions
    .list-item-autorun
    .list-item-remove
      visibility visible

// widget manager: instance detail view (widget-instance-detail.jsx)
.widget-instance-detail
  display flex
  flex-direction column
  min-height 0
  height 100%
.wil-head
  display flex
  align-items center
  justify-content space-between
  gap 8px
  margin-bottom 10px
  flex-shrink 0
.wil-head-title
  min-width 0
  font-size 14px
.wil-descriptions
  // the log is the point of this panel, so a long config list gives up room
  // (and scrolls) instead of squeezing it: shrinkable, and allowed to go below
  // its content height, with the pane holding a floor of its own
  flex 0 1 auto
  min-height 0
  overflow auto
  // long values (paths, URLs, keys) must wrap instead of widening the panel
  .ant-descriptions-item-label
    width 90px
    white-space nowrap
  .ant-descriptions-item-content
    word-break break-all
.wil-mono
  font-family monospace
  font-size 12px
.wil-switch
  margin 10px 0 6px
  flex-shrink 0
.wil-pane
  flex 1
  // a floor, so the log stays readable no matter how long the config list is
  min-height 200px
  overflow auto
  padding 6px 8px
  background var(--main-dark)
  border 1px solid var(--main-light)
  border-radius 4px
  font-family monospace
  font-size 12px
  line-height 1.6
.wil-line
  display flex
  gap 6px
  white-space pre-wrap
  word-break break-word
  border-bottom 1px solid var(--main-light)
  &:last-child
    border-bottom 0
.wil-time
  flex-shrink 0
  color var(--text-disabled)
.wil-mark
.wil-type
  flex-shrink 0
.wil-from
  flex-shrink 0
  color var(--text-dark)
.wil-msg
  min-width 0
.wil-debug
  color var(--text-dark)
.wil-log
  color var(--text)
.wil-warn
  color var(--warn)
.wil-error
  color var(--error)
.wil-ok
  color var(--success)
  .wil-mark
    color var(--success)
.wil-fail
  color var(--error)
  .wil-mark
    color var(--error)
.wil-info
  color var(--text-dark)
.wil-empty
  color var(--text-dark)
  padding 6px 0
.wil-path
  flex-shrink 0
  margin-top 6px
  color var(--text-disabled)
  font-size 11px

// an AI config a widget offers to apply (widget-ai-config.jsx). Sits between
// the instance facts and the log, and in the config-mode result view.
.wac
  flex-shrink 0
  margin 10px 0
  padding 8px 10px
  border 1px solid var(--main-light)
  border-radius 4px
  background var(--main-dark)
.wac-head
  display flex
  align-items center
  gap 8px
  margin-bottom 4px
.wac-title
  font-size 12px
  font-weight 500
.wac-desc
  margin 0 0 6px
  color var(--text-dark)
  font-size 11px
.wac-rows
  display flex
  flex-direction column
  gap 2px
  margin-bottom 8px
.wac-row
  display flex
  gap 8px
  align-items flex-start
  font-size 12px
.wac-label
  flex 0 0 90px
  color var(--text-dark)
  white-space nowrap
.wac-value
  flex 1
  min-width 0
  display flex
  align-items center
  gap 2px
  font-family monospace
  word-break break-all
.wac-secret
  display flex
  align-items center
  gap 2px
  min-width 0
  max-width 100%
.wac-secret-text
  min-width 60px
  font-family monospace

// user widget list: the import button owns a row of its own above the search
// box, with the wiki help icon beside it (widgets-list.jsx)
.widgets-import-row
  display flex
  align-items center
  // `block` gives the button width 100%; as a flex item it must be allowed to
  // give the help icon its room back
  .ant-btn
    flex 1
    min-width 0

// user widget list: a folder that failed to load stays in the list with a
// warning instead of disappearing (widgets-list.jsx)
.list-item-widget-error
  position absolute
  right 0
  top 0
  width 24px
  line-height 35px
  text-align center
  color var(--warn)

// custom widget UI: the widget's own document owns the panel
// (custom-widget-panel.jsx)
.custom-widget-panel
  display flex
  flex-direction column
  height 100%
  min-height 0
.cwp-head
  display flex
  align-items center
  justify-content space-between
  gap 8px
  margin-bottom 10px
  flex-shrink 0
.cwp-title
  min-width 0
  font-size 14px
.cwp-version
  margin-left 8px
  font-size 11px
  color var(--text-dark)
.cwp-frame
  flex 1
  min-height 0
  width 100%
  border 0
  border-radius 4px
  // the widget document inherits nothing; it sets its own colors from the
  // variables the host hands it (see widget-bridge.js)
  background var(--main-dark)
  color-scheme inherit

// config-mode user widget: generated form + the action's result
// (custom-widget-form.jsx)
.cwf-desc
  margin-bottom 10px
  color var(--text-dark)
.cwf-result
  margin-top 6px
.cwf-result-head
  margin-bottom 4px
.cwf-details
  display flex
  flex-direction column
  gap 4px
  margin-bottom 10px
.cwf-detail
  display flex
  gap 8px
  align-items flex-start
.cwf-detail-label
  flex 0 0 110px
  color var(--text-dark)
  word-break break-word
.cwf-detail-value
  flex 1
  min-width 0
  display flex
  align-items center
  gap 2px
  font-family monospace
  font-size 12px
  word-break break-all
.cwf-secret
  display flex
  align-items center
  gap 2px
  min-width 0
  max-width 100%
.cwf-secret-text
  min-width 60px
  font-family monospace
.cwf-cell
  display flex
  align-items center
  gap 2px
  min-width 0
.cwf-table
  font-size 12px
  margin-bottom 10px
  .ant-table-cell
    padding 4px 6px
.cwf-buttons
  margin-top 8px
.cwf-json
  font-family monospace
  font-size 12px
  white-space pre-wrap
  word-break break-all
  max-height 240px
  overflow auto
