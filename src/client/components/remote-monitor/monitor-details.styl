.remote-monitor-sparkline
  display block
  overflow visible
  color var(--primary)
  transition color 120ms ease

.remote-monitor-empty
  color var(--text-disabled)

.remote-monitor-popover
  // 488 - antd popover innerPadding 12*2 = 464 content, just clears the widest table
  // (network, Σ列宽 460) so the desktop popover never needs a horizontal scrollbar
  width 488px
  max-width calc(100vw - 32px)
  max-height calc(100dvh - 80px - var(--shortcut-bar-kb-offset, 0px))
  // tables own their own horizontal overflow via scroll.x, so the panel never needs
  // to scroll sideways (that would drag the heading and the info button along)
  overflow-x hidden
  overflow-y auto

.remote-monitor-detail-heading
  margin-bottom 8px
  color var(--text)
  font-size 13px
  font-weight 600

.remote-monitor-detail-state
  margin 6px 0
  color var(--text-disabled)

.remote-monitor-detail-rows
  margin 0 0 8px

.remote-monitor-detail-row
  display grid
  grid-template-columns minmax(0, 0.45fr) minmax(0, 1fr)
  gap 10px
  padding 3px 0
  dt
    color var(--text-dark)
  dd
    min-width 0
    margin 0
    overflow hidden
    text-overflow ellipsis
    color var(--text)
    font-variant-numeric tabular-nums

.remote-monitor-detail-chart
  display flex
  align-items center
  justify-content center
  margin 8px 0
  padding 4px
  .remote-monitor-sparkline
    max-width 100%

.remote-monitor-activity
  margin-top 10px

// antd Table owns the whole table layout, only the dense metrics look is kept
.remote-monitor-table
  font-variant-numeric tabular-nums
  .ant-table.ant-table-small
    font-size 11px

// click a value cell copies it (see withCellCopy)
.remote-monitor-copy-cell
  cursor pointer
  &:hover
    color var(--primary)

.remote-monitor-item.remote-monitor-level-warning,
.remote-monitor-level-warning
  color var(--warn)

.remote-monitor-item.remote-monitor-level-critical,
.remote-monitor-level-critical
  color var(--error)

.remote-monitor-item.remote-monitor-level-unknown,
.remote-monitor-level-unknown
  color var(--text-disabled)

@media (prefers-reduced-motion: reduce)
  .remote-monitor-sparkline
    transition none
