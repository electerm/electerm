.remote-monitor-bar
  position absolute
  bottom 36px
  z-index 188
  overflow hidden
  display flex
  background var(--main)
  color var(--text)
  font-size 12px
  font-variant-numeric tabular-nums
  user-select none

.remote-monitor-scroll
  min-width 0
  flex 1
  display flex
  overflow-x auto
  overflow-y hidden
  scrollbar-width none // Firefox
  -ms-overflow-style none // IE/Edge
  overscroll-behavior-x contain
  &::-webkit-scrollbar
    width 0
    height 0
    display none

.remote-monitor-item
  height 100%
  flex-shrink 0
  display inline-flex
  align-items center
  gap 4px
  padding 0 9px
  border 0
  outline none
  background transparent
  color var(--text)
  font inherit
  white-space nowrap
  cursor default
  transition color 120ms ease, background-color 120ms ease
  &:hover,
  &:focus-visible
    background var(--main-light)
  &:focus-visible
    box-shadow inset 0 0 0 1px var(--primary)

.remote-monitor-item-hostname
  display block
  max-width 220px
  overflow hidden
  text-overflow ellipsis

.remote-monitor-disk-summary
  display inline-flex
  align-items center
  gap 6px

.remote-monitor-status-marker
  flex-shrink 0
  font-size 10px

.remote-monitor-message
  display flex
  align-items center
  min-width max-content
  padding 0 10px
  color var(--text-disabled)
  font-variant-numeric tabular-nums

.remote-monitor-controls
  flex-shrink 0
  display flex
  align-items center
  opacity 0
  pointer-events none
  .ant-btn
    width 28px
    height 100%
    padding 0
    color var(--text-dark)
    &:hover,
    &:focus-visible
      color var(--text)
      background var(--main-light)

.remote-monitor-bar:hover,
.remote-monitor-bar:focus-within,
.is-mobile,
.is-touch-device
  .remote-monitor-controls
    opacity 1
    pointer-events auto

@media (prefers-reduced-motion: reduce)
  .remote-monitor-item
    transition none
