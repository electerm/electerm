// "create with AI" tab of the quick command form
.qm-ai-editor
  // the generated quick command, kept visible for reference after it has been
  // written back into the form
  .qm-ai-preview
    padding 12px
    margin 0
    max-height 300px
    overflow auto
    font-size 12px
    font-family monospace
    white-space pre-wrap
    word-break break-word
