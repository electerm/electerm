.qm-list-wrap
  max-height calc(100vh - 100px)
  overflow-y scroll
  padding 20px 0 10px 0

// Docked in the right side panel the panel *is* the container, so the quick
// commands fill it instead of sizing themselves like the footer box. The parent
// (.right-side-panel-content) is an absolutely positioned box with top and
// bottom set, so 100% resolves to a real height and the list scrolls inside it
// rather than scrolling the panel.
.qm-panel-in-right-panel
  display flex
  flex-direction column
  width 100%
  height 100%
  > .pd2
    display flex
    flex-direction column
    height 100%
    min-height 0
    width 100%
  .qm-flex
    flex-shrink 0
    // the footer box is as wide as the footer; the right panel is not, and the
    // search + label + sort + actions row does not fit in one line there
    flex-wrap wrap
  // ...so give the search a line of its own and let it fill it, instead of
  // sitting at its footer width with a gap beside it. `flex-basis: 100%` is what
  // forces the wrap; the controls then share the line below.
  .qm-search-input
    flex 1 1 100%
    max-width none
  .qm-list-wrap
    flex 1
    min-height 0
    max-height none
    overflow-y auto

.qm-panel-actions
  display flex
  align-items center
  gap 6px

.qm-move-icon
  font-size 14px
  padding 4px
  cursor pointer
  &:hover
    color var(--primary)

// The footer Q stays lit while the panel is docked in the right panel, same
// contract as the info, AI and cmd history icons
.quick-command-trigger
  &.active
    color var(--success)

.qm-wrap-tooltip
  background var(--main)
  position absolute
  left var(--left-side-bar-width, 43px)
  right 0
  z-index 89
  height auto

  bottom var(--footer-stack-height, 36px)

.qm-pinned
  .qm-wrap-tooltip
    height 180px
  .qm-list-wrap
    max-height 100px

.qm-search-input
  max-width 200px
@media (max-width: 500px)
  .qm-search-input
    width 100px

.item-list-unit.dragover
  border: 1px dashed var(--primary)
.qm-item-dragover
  border-left 2px solid var(--primary)
.qm-field-dragging
  opacity 0.4
.qm-field-dragover
  border-top 2px solid var(--primary)
.qm-label-select
  min-width 120px
.qm-name-input
  max-width 160px
  min-width 80px

.qm-flex
  gap 8px

.qm-tooltip-content
  max-width 360px
  .qm-tooltip-title
    font-weight 600
    margin-bottom 4px
    word-break break-word
  .qm-tooltip-cmd-list
    margin 0
    padding 0
    list-style none
    .qm-tooltip-cmd-item
      padding 4px 0
      border-top 1px solid rgba(255,255,255,0.15)
      &:first-child
        border-top none
      .qm-tooltip-label
        opacity 0.65
        margin-right 4px
      .qm-tooltip-value
        word-break break-word
      code
        font-family monospace
  .qm-tooltip-meta
    margin-top 4px
    padding-top 4px
    border-top 1px solid rgba(255,255,255,0.15)
    .qm-tooltip-label
      opacity 0.65
      margin-right 4px

@media (max-width: 768px)
  .qm-flex
    flex-direction column
    align-items flex-start
  .qm-search-input
    max-width none
    width 100%
  .qm-label-select
    width 100%
  // The docked panel's search claims a whole row with `flex-basis: 100%`, which
  // is a width only while `.qm-flex` is a row. Here it is a column, so the same
  // basis would be 100% of the *height* and would push the controls off the
  // panel. Same specificity as the rule above it, declared later, so it wins.
  .qm-panel-in-right-panel .qm-search-input
    flex none

// step editor: one row per step (drag, #, type, name, command or key,
// Enter or repeat, delay before, row actions)
.qm-steps
  // name and command/key shrink first, so the delay and row actions stay
  // visible in a narrow window
  .qm-step-row
    display flex
    align-items center
    gap 6px
    margin-bottom 6px
  .qm-step-head
    margin-bottom 2px
    opacity 0.7
    font-size 12px
    .qm-step-name
    .qm-step-value
    .qm-step-delay
      white-space nowrap
      overflow hidden
  .qm-step-drag
    width 14px
    flex none
    cursor grab
  .qm-step-index
    width 18px
    flex none
    text-align right
    opacity 0.7
  .qm-step-type
    width 132px
    flex none
  .qm-step-name
    flex 0 1 120px
    min-width 56px
  .qm-step-value
    flex 1 1 160px
    min-width 90px
  .qm-step-option
    width 80px
    flex none
  .qm-step-delay
    width 96px
    flex none
  .qm-step-ops
    width 78px
    flex none
    white-space nowrap

// narrow editor (small window or settings panel): two lines per step.
// Line 1 is type, command or key, and the row actions. Line 2 is name,
// Enter or repeat, and delay. The header row wraps the same way. Written as plain CSS for the container query.
.qm-steps
  container-type inline-size
@css {
  @container (max-width: 640px) {
    .qm-steps .qm-step-row {
      display: grid;
      grid-template-columns: 14px 18px 132px minmax(0, 1fr) 80px 96px;
      grid-template-areas:
        'drag idx type value value ops'
        '. . name name option delay';
      row-gap: 4px;
      padding-bottom: 6px;
      margin-bottom: 8px;
      border-bottom: 1px solid var(--main-darker);
    }
    .qm-steps .qm-step-drag { grid-area: drag; }
    .qm-steps .qm-step-index { grid-area: idx; }
    .qm-steps .qm-step-type { grid-area: type; width: auto; }
    .qm-steps .qm-step-name { grid-area: name; min-width: 0; }
    .qm-steps .qm-step-value { grid-area: value; min-width: 0; }
    .qm-steps .qm-step-option { grid-area: option; width: auto; }
    .qm-steps .qm-step-delay { grid-area: delay; width: auto; }
    .qm-steps .qm-step-ops { grid-area: ops; width: auto; text-align: right; }
  }
}

// On mobile, stack each step's fields instead of one cramped row
.is-mobile
  .qm-steps
    .qm-step-head
      display none
    .qm-step-row
      flex-wrap wrap
      padding-bottom 6px
      border-bottom 1px solid var(--main-darker)
    .qm-step-name
    .qm-step-value
      width 100%
      flex 1 1 100%

// footer chip for a running quick command: blue progress part on the left,
// red stop part filling the right end
.terminal-footer-qm-run
  display flex
  align-items center
  max-width 440px
.qm-run-chip
  display flex
  align-items center
  line-height 24px
  border-radius 12px
  overflow hidden
  background var(--primary)
  color var(--primary-contrast)
  min-width 0
  .qm-run-info
    display flex
    align-items center
    padding 0 8px 0 10px
    min-width 0
  .qm-run-name
    max-width 140px
  // the name gives way first, the waiting text matters more
  .qm-run-wait
    max-width 200px
    flex-shrink 0
  .qm-run-stop
    display flex
    align-items center
    align-self stretch
    padding 0 10px 0 8px
    background var(--error, #e5484d)
    color #fff
    &:hover
      filter brightness(1.1)

// footer chip while recording: a pulsing red dot, then save and cancel
.qm-rec-chip
  background var(--main-lighter)
  color var(--text)
  .qm-rec-save
  .qm-rec-cancel
    display flex
    align-items center
    align-self stretch
    padding 0 10px
    &:hover
      filter brightness(1.1)
  .qm-rec-save
    background var(--primary)
    color var(--primary-contrast)
  .qm-rec-cancel
    background var(--main-darker)
.qm-rec-dot
  display inline-block
  width 10px
  height 10px
  border-radius 50%
  background var(--error, #e5484d)
  flex none
  .qm-rec-chip &
    animation qm-rec-pulse 1.2s ease-in-out infinite
@keyframes qm-rec-pulse
  50%
    opacity 0.35
