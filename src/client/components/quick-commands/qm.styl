.qm-list-wrap
  max-height calc(100vh - 100px)
  overflow-y scroll
  padding 20px 0 10px 0

// Docked in the right side panel the panel *is* the container, so the quick
// commands fill it instead of sizing themselves like the footer box. The parent
// (.right-side-panel-content) is an absolutely positioned box with top and
// bottom set, so 100% resolves to a real height and the list scrolls inside it
// rather than scrolling the panel.
.qm-panel-in-right-panel
  display flex
  flex-direction column
  width 100%
  height 100%
  > .pd2
    display flex
    flex-direction column
    height 100%
    min-height 0
    width 100%
  .qm-flex
    flex-shrink 0
    // the footer box is as wide as the footer; the right panel is not, and the
    // search + label + sort + actions row does not fit in one line there
    flex-wrap wrap
  // ...so give the search a line of its own and let it fill it, instead of
  // sitting at its footer width with a gap beside it. `flex-basis: 100%` is what
  // forces the wrap; the controls then share the line below.
  .qm-search-input
    flex 1 1 100%
    max-width none
  .qm-list-wrap
    flex 1
    min-height 0
    max-height none
    overflow-y auto

.qm-panel-actions
  display flex
  align-items center
  gap 6px

.qm-move-icon
  font-size 14px
  padding 4px
  cursor pointer
  &:hover
    color var(--primary)

// The footer Q stays lit while the panel is docked in the right panel, same
// contract as the info, AI and cmd history icons
.quick-command-trigger
  &.active
    color var(--success)

.qm-wrap-tooltip
  background var(--main)
  position absolute
  left var(--left-side-bar-width, 43px)
  right 0
  z-index 89
  height auto

  bottom var(--footer-stack-height, 36px)

.qm-pinned
  .qm-wrap-tooltip
    height 180px
  .qm-list-wrap
    max-height 100px

.qm-search-input
  max-width 200px
@media (max-width: 500px)
  .qm-search-input
    width 100px

.item-list-unit.dragover
  border: 1px dashed var(--primary)
.qm-item-dragover
  border-left 2px solid var(--primary)
.qm-field-dragging
  opacity 0.4
.qm-field-dragover
  border-top 2px solid var(--primary)
.qm-label-select
  min-width 120px
.qm-name-input
  max-width 160px
  min-width 80px

.qm-flex
  gap 8px

.qm-tooltip-content
  max-width 360px
  .qm-tooltip-title
    font-weight 600
    margin-bottom 4px
    word-break break-word
  .qm-tooltip-cmd-list
    margin 0
    padding 0
    list-style none
    .qm-tooltip-cmd-item
      padding 4px 0
      border-top 1px solid rgba(255,255,255,0.15)
      &:first-child
        border-top none
      .qm-tooltip-label
        opacity 0.65
        margin-right 4px
      .qm-tooltip-value
        word-break break-word
      code
        font-family monospace
  .qm-tooltip-meta
    margin-top 4px
    padding-top 4px
    border-top 1px solid rgba(255,255,255,0.15)
    .qm-tooltip-label
      opacity 0.65
      margin-right 4px

@media (max-width: 768px)
  .qm-flex
    flex-direction column
    align-items flex-start
  .qm-search-input
    max-width none
    width 100%
  .qm-label-select
    width 100%
  // The docked panel's search claims a whole row with `flex-basis: 100%`, which
  // is a width only while `.qm-flex` is a row. Here it is a column, so the same
  // basis would be 100% of the *height* and would push the controls off the
  // panel. Same specificity as the rule above it, declared later, so it wins.
  .qm-panel-in-right-panel .qm-search-input
    flex none

// On mobile, stack the quick-command row (name / delay / command / remove)
// vertically instead of side by side — the horizontal Space.Compact layout
// is too cramped on narrow screens.
.is-mobile
  .qm-cmd-row.ant-space-compact
    display flex
    flex-direction column
    align-items stretch
    gap 8px
    .ant-space-compact-item
      width 100%
    // reset the constrained widths so inputs fill the row when stacked
    .qm-name-input
      max-width none
      width 100%
    .ant-input-number
      width 100% !important
    // keep the drag handle + remove button on a tidy line of their own
    > .drag
      align-self flex-start
    > button:last-child
      align-self flex-end
