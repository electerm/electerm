
.tabs
  position relative
  height 46px
  overflow hidden
  background #0E1116
  border-bottom 1px solid var(--border-color)
  z-index 12
  ::-webkit-scrollbar
    width 0
    display none
.not-system-ui.is-mac .layout-item.v1 .tabs-inner
  margin-left 42px
.not-system-ui.is-mac.not-webapp .layout-item.v1
  .tabs-inner
    margin-left 72px
.not-system-ui.is-mac.not-webapp.pinned .layout-item.v1
  .tabs-inner
    margin-left 0
.not-system-ui.not-mac.not-webapp
  .tabs-extra
    right 96px
.tabs-inner
  position relative
  z-index 2
  padding 0
  margin-top 0
  display inline-block
  height 46px
  overflow-x scroll
  overflow-y hidden

.tabs-wrapper
  z-index 3
.tab
  display inline-block
  vertical-align bottom
  cursor pointer
  position relative
  padding 0 14px
  min-width 100px
  max-width 200px
  line-height 36px
  margin 0 1px 0 0
  border-radius 6px 6px 0 0
  background transparent
  text-align center
  color var(--text-dark)
  transition background-color .12s ease
  &.tab-last
    margin-right 5px
  &.active
    color var(--text)
    background #161A21
    box-shadow inset 0 2px 0 #E0567A
    .tab-count
      background #E0567A
      color #14060A
  &.active-all
    font-weight bold
  &:hover
    .tab-close
      opacity 1
  &.dragover-tab::after
    position absolute
    content ''
    left -2px
    top 0
    width 1px
    border 1px dashed var(--text-dark)
    height 36px
  &.dragover-tab-after::after
    position absolute
    content ''
    right -2px
    top 0
    width 1px
    border 1px dashed var(--text-dark)
    height 36px
@keyframes blink
  0%
    background-color #e0e0e0
  50%
    background-color #ffffff
  100%
    background-color #e0e0e0

.tab-terminal-feed
.tab-traffic
.tab-status
  position absolute
  left 2px
  top 2px
  width 5px
  height 5px
  border-radius 5px
  background-color var(--text-dark)
  &.success
    background-color var(--success)
  &.error
    background-color var(--error)
  &.processing
    background-color var(--primary)
.tab-traffic
  left 10px
  width 5px
  border-radius 0
  background-color var(--success)
  animation blink 2s infinite
.tab-terminal-feed
  width 12px
  height 12px
  border-radius 0
  color var(--success)
  font-size 12px
  left 2px
  top 24px
  background none
  background-color transparent !important
  animation blink 2s infinite
  &.password
    color var(--warn)
.tab-close
  position absolute
  right 5px
  cursor pointer
  top 50%
  background var(--main)
  margin-top -8px
  border-radius 100%
  color var(--text)
  height 16px
  width 16px
  text-align center
  line-height 16px
  font-size 10px
  opacity .45
  transition opacity .12s ease, background-color .12s ease
  &:hover
    opacity 1
    background var(--error)

.tabs-add-btn
  display inline-flex
  align-items center
  justify-content center
  vertical-align bottom
  width 30px
  height 30px
  margin 0 0 8px 8px
  border 1px solid var(--border-color)
  border-radius 6px
  color var(--text-dark)
  &.empty
    font-size 20px
    margin-left 20px
    margin-top 10px
  &:hover
    color var(--text-light)
    border-color #E0567A
.tabs-extra
  position absolute
  height 40px
  top 0
  right 0
  line-height 40px
  z-index 20

  .tabs-dd-icon
    font-size 12px
  .tabs-add-btn
    margin-top 0

.window-controls
  position absolute
  right 0
  top 0
  z-index 900
  border-radius 0 0 3px 3px
  padding 0
  background var(--main)
  -webkit-app-region no-drag

.window-control-box
  display inline-block
  padding 5px 10px
  color var(--text)
  &:hover
    color var(--primary)
    cursor pointer
    .icon-maximize
      border-color var(--primary)
.icon-maximize
  width 10px
  height 7px
  border 1px solid var(--text)
  cursor pointer
  &.is-max
    height 6px
    position relative
    &:before
      position absolute
      content ''
      left -3px
      top 3px
      width 8px
      height 4px
      border 1px solid text
      border-top none
      border-right none

.control-icon:hover
  color var(--text-light)
.tab-scroll-icon
  color var(--text-dark)
  &:hover
    color var(--text)

.window-controls
  .window-control-minimize
  .window-control-maximize
    &:hover
      background var(--main-dark)
  .window-control-close:hover
    background var(--error)

.system-ui
  .window-controls
    display none
.tab-title-tag
  margin-right 5px
  font-size 14px

.tab-label
  font-size 13px

.tab-count
  display inline-flex
  align-items center
  justify-content center
  width 18px
  height 18px
  border-radius 4px
  vertical-align middle
  background #232932
  color var(--text-dark)
  font-family 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace
  font-size 11px
  font-weight 600

.ssh-tunnel-list-wrapper
  max-height 300px
  overflow-y auto

// Layout and Workspace dropdown styles
.layout-workspace-dropdown
  background var(--main)
  border-radius 4px
  box-shadow 0 2px 8px rgba(0, 0, 0, 0.15)
  min-width 200px
  padding 8px
  .ant-tabs-nav
    margin-bottom 8px

.layout-menu-content
  max-height 300px
  overflow-y auto

.layout-menu-item
  padding 6px 12px
  cursor pointer
  border-radius 4px
  display flex
  align-items center
  gap 8px
  color var(--text)
  &:hover
    background var(--main-dark)
  &.active
    background var(--primary)
    color #fff

.workspace-menu-content
  max-height 300px
  overflow-y auto

.workspace-save-btn
  margin-bottom 8px

.workspace-list
  display flex
  flex-direction column
  gap 4px

.workspace-item
  padding 6px 12px
  cursor pointer
  border-radius 4px
  display flex
  align-items center
  justify-content space-between
  color var(--text)
  &:hover
    background var(--main-dark)
  .workspace-delete-icon
    opacity 0
    color var(--text-dark)
    &:hover
      color var(--error)
  &:hover .workspace-delete-icon
    opacity 1

.workspace-name
  flex 1
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.not-webapp.not-win
  .tab
  .tabs-add-btn
  .window-control-box
  .tab-close
  .tab-reload
  .tabs-extra
    -webkit-app-region no-drag
