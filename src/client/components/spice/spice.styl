// SPICE only styling — the session layout (control bar, viewport, fit mode)
// lives in the shared remote session shell: common/remote-session-shell.styl
.spice-session-wrap
  // fit: the mount box fills the viewport and the canvas (sized by the spice
  // client to the remote resolution) is scaled to it, keeping the ratio.
  // !important because the client writes the surface size into the mount box
  // inline style (`screen_id` height = surface height).
  &.fit
    .spice-session-mount
      width 100% !important
      height 100% !important
      display flex
      align-items center
      justify-content center
      canvas
        width 100% !important
        height 100% !important
        max-width 100% !important
        max-height 100% !important
        object-fit contain
