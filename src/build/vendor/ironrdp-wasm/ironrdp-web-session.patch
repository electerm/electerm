+/// Smallest rectangle covering both inputs. Both must be valid image regions.
+fn union_rectangles(a: InclusiveRectangle, b: InclusiveRectangle) -> InclusiveRectangle {
+    InclusiveRectangle {
+        left: a.left.min(b.left),
+        top: a.top.min(b.top),
+        right: a.right.max(b.right),
+        bottom: a.bottom.max(b.bottom),
+    }
