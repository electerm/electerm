# run `cp ./src/build/.sample.env ./src/build/.env` to create your local env

## test env

## No test server needed on Linux: start a local one instead of pointing at a
## remote box, then use these values. See src/build/bin/local-ssh-test-server.sh
## (CI does exactly this, no secrets involved).
#   sudo bash src/build/bin/local-ssh-test-server.sh
TEST_HOST=127.0.0.1
TEST_PORT=2222
TEST_USER=etest
TEST_PASS=electerm-test

## or point at your own ssh/sftp test host:
## test ssh ip or host, required
# TEST_HOST=0.0.0.0

## test ssh username, required
# TEST_USER=xxx

## test ssh port, optional, default 22
# TEST_PORT=22

## test ssh password, required
# TEST_PASS=xxx

DATA_PATH=/path/to/save/data
